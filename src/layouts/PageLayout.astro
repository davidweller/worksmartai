---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData, inferSectorFromPath, type SiteSector } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  sector?: SiteSector;
}

const { metadata, sector: sectorProp } = Astro.props;
const sector = sectorProp ?? inferSectorFromPath(Astro.url.pathname);
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header {...headerData} isSticky />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} sector={sector} />
  </slot>
</Layout>
