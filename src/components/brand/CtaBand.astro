---
import CornerDevice from '~/components/brand/CornerDevice.astro';
import { CTAS } from '~/data/brand/ctas';

interface Props {
  title?: string;
  subtitle?: string;
  /** A secondary call to action from the ladder, for readers not ready to talk. */
  secondary?: keyof typeof CTAS | false;
}

const {
  title = 'Find out where AI will save your people the most time',
  subtitle = 'A free 30-minute call and a written report placing your team on the AI Use Hierarchy, with two or three next steps.',
  secondary = 'calculator',
} = Astro.props;
const second = secondary ? CTAS[secondary] : undefined;
---

<section class="relative overflow-hidden bg-brand px-6 py-16 sm:px-8 lg:px-12 lg:py-20">
  <CornerDevice tone="dark" class="w-16 sm:w-24 lg:w-32" />
  <div class="relative z-10 mx-auto max-w-3xl text-center">
    <h2 class="font-heading text-2xl font-bold text-white sm:text-3xl lg:text-4xl">{title}</h2>
    <p class="mt-5 text-base text-white/90 sm:text-lg">{subtitle}</p>
    <div class="mt-8 flex flex-col items-center gap-4">
      <a
        href={CTAS.primary.href}
        class="inline-flex items-center justify-center rounded-full bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#e55f00]"
      >
        {CTAS.primary.text}
      </a>
      {
        second && (
          <a
            href={second.href}
            class="font-sans text-sm text-white/90 underline underline-offset-4 transition hover:text-white"
          >
            {second.text}
          </a>
        )
      }
    </div>
  </div>
</section>
