---
import Button from '~/components/ui/Button.astro';
import { CTAS } from '~/data/brand/ctas';

interface Props {
  title?: string;
  subtitle?: string;
  /** A secondary call to action from the ladder, for readers not ready to talk. */
  secondary?: keyof typeof CTAS | false;
}

const {
  title = 'Find out where AI will save your people the most time',
  subtitle = 'A free 30-minute call and a written report placing your team on the AI Use Hierarchy, with two or three next steps.',
  secondary = 'calculator',
} = Astro.props;
const second = secondary ? CTAS[secondary] : undefined;
---

<section class="bg-brand px-6 py-16 sm:px-8 lg:px-12 lg:py-20">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-heading text-2xl font-bold text-white sm:text-3xl lg:text-4xl">{title}</h2>
    <p class="mt-5 text-base text-white/90 sm:text-lg">{subtitle}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <Button variant="primary" href={CTAS.primary.href} text={CTAS.primary.text} />
      {
        second && (
          <a
            href={second.href}
            class="font-semibold text-white underline decoration-secondary underline-offset-4 hover:text-secondary"
          >
            {second.text}
          </a>
        )
      }
    </div>
  </div>
</section>
