---
import { COURSES, STREAM_LABELS, type CourseStream } from '~/data/brand/courses';

interface Props {
  streams?: CourseStream[];
  /** Show a heading above each stream's cards. Off when only one stream is shown. */
  groupHeadings?: boolean;
}

const { streams = ['all-staff', 'academic', 'professional-services'], groupHeadings = streams.length > 1 } =
  Astro.props;

const groups = streams
  .map((stream) => ({ stream, label: STREAM_LABELS[stream], courses: COURSES.filter((c) => c.stream === stream) }))
  .filter((g) => g.courses.length);
---

<div class="space-y-10">
  {
    groups.map((g) => (
      <div>
        {groupHeadings && (
          <h3 class="mb-5 font-heading text-lg font-bold text-heading sm:text-xl">
            {g.label} <span class="text-sm font-medium text-muted">({g.courses.length})</span>
          </h3>
        )}
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {g.courses.map((c) => (
            <li class="relative flex h-full flex-col overflow-hidden rounded-xl border border-primary/20 bg-card p-6 shadow-card">
              <span class="absolute inset-x-0 top-0 h-1 bg-accent" aria-hidden="true" />
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">{g.label}</p>
              <h4 class="mt-2 font-heading text-lg font-bold leading-snug text-heading">{c.title}</h4>
              <p class="mt-3 text-sm leading-relaxed text-default">{c.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
