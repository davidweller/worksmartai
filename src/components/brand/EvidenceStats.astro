---
import type { Evidence } from '~/data/brand/evidence';

interface Props {
  items: Evidence[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((e) => (
      <figure class="flex h-full flex-col rounded-xl border border-primary/20 bg-card p-6 shadow-card">
        <p class="font-heading text-4xl font-bold text-primary">{e.stat}</p>
        <p class="mt-2 flex-1 text-default">{e.claim}</p>
        <figcaption class="mt-4 text-xs text-muted">Source: {e.source}</figcaption>
      </figure>
    ))
  }
</div>
