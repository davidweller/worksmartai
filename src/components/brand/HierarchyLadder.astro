---
import { HIERARCHY } from '~/data/brand/hierarchy';

interface Props {
  /** Also show the capability, confidence and compliance matrix. */
  matrix?: boolean;
  /** Level selected when the page loads. */
  initial?: number;
}

const { matrix = false, initial = 1 } = Astro.props;
const rows = [
  { label: 'Capability', key: 'capability' },
  { label: 'Confidence', key: 'confidence' },
  { label: 'Compliance', key: 'compliance' },
] as const;
const id = `ladder-${Math.random().toString(36).slice(2, 9)}`;
// Step heights rise with the level, so the ladder reads as a climb on wide screens.
const heights = ['md:min-h-28', 'md:min-h-36', 'md:min-h-44', 'md:min-h-52', 'md:min-h-60'];
---

<div class="hierarchy-ladder not-prose my-8" data-hierarchy-ladder data-initial={initial}>
  <ol class="grid grid-cols-1 gap-2 md:grid-cols-5 md:items-end md:gap-3" aria-label="The five levels of AI use">
    {
      HIERARCHY.map((l, i) => (
        <li>
          <button
            type="button"
            class:list={[
              'ladder-step group relative flex w-full items-center gap-3 rounded-xl bg-[#015887] p-4 text-left text-white transition hover:bg-[#014a72] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF7700] md:flex-col md:items-start md:justify-end',
              heights[i],
            ]}
            data-level={l.level}
            aria-controls={`${id}-${l.level}`}
            aria-pressed={l.level === initial ? 'true' : 'false'}
          >
            <span class="ladder-marker absolute inset-x-0 top-0 h-1.5 rounded-t-xl bg-[#FF7700]" aria-hidden="true" />
            <span class="ladder-number inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15 font-heading font-bold">
              {l.level}
            </span>
            <span class="font-heading text-base font-bold leading-snug">{l.name}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="mt-6" aria-live="polite">
    {
      HIERARCHY.map((l) => (
        <div
          id={`${id}-${l.level}`}
          class="ladder-panel mb-4 rounded-xl border border-primary/20 border-l-4 border-l-[#FF7700] bg-card p-6 shadow-card"
          data-panel={l.level}
        >
          <h3 class="font-heading text-lg font-bold text-heading">
            Level {l.level}: {l.name}
          </h3>
          <p class="mt-2 text-default">{l.meaning}</p>
          <p class="mt-4 text-default">
            <span class="font-heading font-bold text-[#FF7700]">A task at this level: </span>
            {l.exampleTask}
          </p>
        </div>
      ))
    }
  </div>
</div>

{
  matrix && (
    <div class="mt-10 overflow-x-auto rounded-xl border border-primary/20 bg-card shadow-card">
      <table class="w-full min-w-[48rem] text-left text-sm">
        <caption class="sr-only">Capability, confidence and compliance at each level</caption>
        <thead class="bg-primary/8">
          <tr>
            <th scope="col" class="p-4" />
            {HIERARCHY.map((l) => (
              <th scope="col" class="p-4 font-heading font-bold text-heading">
                L{l.level} {l.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t border-primary/10 align-top">
              <th scope="row" class="p-4 font-heading font-bold text-primary">
                {r.label}
              </th>
              {HIERARCHY.map((l) => (
                <td class="p-4 text-default">{l[r.key]}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

<style>
  /* Without JavaScript every panel shows as a list; the script then shows one at a time. */
  .ladder-marker {
    opacity: 0;
  }
  .ladder-step[aria-pressed='true'] .ladder-marker {
    opacity: 1;
  }
  .ladder-step[aria-pressed='true'] .ladder-number {
    background-color: #ff7700;
  }
  .hierarchy-ladder.is-ready .ladder-panel:not(.is-active) {
    display: none;
  }
</style>

<script>
  function initLadder(root: HTMLElement) {
    const steps = [...root.querySelectorAll<HTMLButtonElement>('.ladder-step')];
    const panels = [...root.querySelectorAll<HTMLElement>('.ladder-panel')];
    const select = (level: number, focus = false) => {
      steps.forEach((s) => {
        const on = Number(s.dataset.level) === level;
        s.setAttribute('aria-pressed', String(on));
        if (on && focus) s.focus();
      });
      panels.forEach((p) => p.classList.toggle('is-active', Number(p.dataset.panel) === level));
    };
    steps.forEach((s, i) => {
      s.addEventListener('click', () => select(Number(s.dataset.level)));
      s.addEventListener('keydown', (e) => {
        const next = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        const j = (i + next + steps.length) % steps.length;
        select(Number(steps[j].dataset.level), true);
      });
    });
    select(Number(root.dataset.initial) || 1);
    root.classList.add('is-ready');
  }

  document.querySelectorAll<HTMLElement>('[data-hierarchy-ladder]').forEach(initLadder);
</script>
