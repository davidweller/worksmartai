---
import { Icon } from 'astro-icon/components';
import { getSupabaseAnonKey, getSupabaseUrl } from '~/lib/supabase/env';

const supabaseUrl = getSupabaseUrl();
const supabaseAnonKey = getSupabaseAnonKey();
const notificationUrl = supabaseUrl
  ? `${supabaseUrl.replace(/\/$/, '')}/functions/v1/send-schools-lead-notification`
  : '';

const roleOptions = ['Headteacher / Deputy', 'School Business Manager', 'Trust IT / Digital Lead', 'Other'];
---

<div class="rounded-2xl border border-[#E0E0E0] bg-white p-6 shadow-[0_6px_28px_-18px_rgba(1,88,135,0.25)] sm:p-8">
  <h2 class="font-heading text-2xl font-bold text-[#015887]">Book a 20-minute call</h2>
  <p class="mt-2 font-sans text-sm leading-[1.65] text-[#1B0101]">
    Tell us a little about your school or trust and we will be in touch to arrange a short call.
  </p>

  <form
    id="schools-lead-form"
    class="mt-6 space-y-4"
    data-supabase-url={supabaseUrl}
    data-supabase-anon-key={supabaseAnonKey}
    data-notification-url={notificationUrl}
  >
    <div id="schools-form-fields" class="space-y-4">
      <input type="hidden" name="source" value="schools-contact" />

      <div>
        <label for="schools-name" class="block font-heading text-sm font-semibold text-[#015887]">Name</label>
        <input
          id="schools-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          class="mt-1.5 block w-full rounded-xl border border-[#E0E0E0] bg-[#F8F8F8] px-4 py-3 font-sans text-base text-[#1B0101] focus:border-[#015887] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#86BFE2]"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="schools-org" class="block font-heading text-sm font-semibold text-[#015887]">School or trust</label>
        <input
          id="schools-org"
          name="school_org"
          type="text"
          required
          class="mt-1.5 block w-full rounded-xl border border-[#E0E0E0] bg-[#F8F8F8] px-4 py-3 font-sans text-base text-[#1B0101] focus:border-[#015887] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#86BFE2]"
          placeholder="Your school or trust name"
        />
      </div>

      <div>
        <label for="schools-role" class="block font-heading text-sm font-semibold text-[#015887]">Role</label>
        <select
          id="schools-role"
          name="role"
          required
          class="mt-1.5 block w-full rounded-xl border border-[#E0E0E0] bg-[#F8F8F8] px-4 py-3 font-sans text-base text-[#1B0101] focus:border-[#015887] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#86BFE2]"
        >
          <option value="" disabled selected>Select your role</option>
          {roleOptions.map((role) => <option value={role}>{role}</option>)}
        </select>
      </div>

      <div>
        <label for="schools-email" class="block font-heading text-sm font-semibold text-[#015887]">Email</label>
        <input
          id="schools-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="mt-1.5 block w-full rounded-xl border border-[#E0E0E0] bg-[#F8F8F8] px-4 py-3 font-sans text-base text-[#1B0101] focus:border-[#015887] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#86BFE2]"
          placeholder="you@school.org.uk"
        />
      </div>

      <div>
        <label for="schools-message" class="block font-heading text-sm font-semibold text-[#015887]">
          Message <span class="font-normal text-[#1B0101]/60">(optional)</span>
        </label>
        <textarea
          id="schools-message"
          name="message"
          rows={3}
          class="mt-1.5 block w-full rounded-xl border border-[#E0E0E0] bg-[#F8F8F8] px-4 py-3 font-sans text-base text-[#1B0101] focus:border-[#015887] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#86BFE2]"
          placeholder="Anything useful for us before the call"></textarea>
      </div>

      <p id="schools-form-feedback" class="hidden" role="alert"></p>

      <button
        type="submit"
        class="flex w-full items-center justify-center gap-2 rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:border-[#e55f00] hover:bg-[#e55f00] disabled:cursor-not-allowed disabled:opacity-60"
        data-track="schools_cta_click"
      >
        <Icon name="tabler:calendar" class="h-5 w-5" aria-hidden="true" />
        Send enquiry
      </button>

      <p class="text-center text-xs leading-relaxed text-[#1B0101]/60">
        We will use your details to respond to this enquiry. Read our{' '}
        <a href="/privacy-policy/" class="font-semibold text-[#015887] underline-offset-2 hover:underline">
          privacy policy</a
        >.
      </p>
    </div>
    <p
      id="schools-form-success"
      class="hidden rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800"
      role="status"
    >
      Thank you. We will be in touch shortly to arrange your call.
    </p>
  </form>
</div>

<script>
  import { submitLead } from '~/lib/leads/client';
  import { initTrackClicks } from '~/lib/analytics/track-clicks';

  initTrackClicks();

  const form = document.getElementById('schools-lead-form') as HTMLFormElement | null;
  const formFields = document.getElementById('schools-form-fields');
  const feedback = document.getElementById('schools-form-feedback');
  const success = document.getElementById('schools-form-success');

  if (form) {
    const supabaseUrl = (form.getAttribute('data-supabase-url') || '').trim();
    const supabaseAnonKey = (form.getAttribute('data-supabase-anon-key') || '').trim();
    const notificationUrl = (form.getAttribute('data-notification-url') || '').trim();

    function showError(message: string) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = 'rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-center text-sm text-red-800';
      success?.classList.add('hidden');
    }

    function clearFeedback() {
      if (feedback) {
        feedback.textContent = '';
        feedback.className = 'hidden';
      }
    }

    if (!supabaseUrl || !supabaseAnonKey) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        showError('Enquiries are temporarily unavailable. Please email hello@worksmart-ai.co.uk.');
      });
    } else {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearFeedback();

        const fd = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (submitBtn) submitBtn.disabled = true;

        const result = await submitLead(
          {
            supabaseUrl,
            supabaseAnonKey,
            notificationUrl: notificationUrl || undefined,
          },
          {
            name: String(fd.get('name') || '').trim(),
            email: String(fd.get('email') || '').trim(),
            school_org: String(fd.get('school_org') || '').trim(),
            role: String(fd.get('role') || '').trim(),
            message: String(fd.get('message') || '').trim(),
            source: String(fd.get('source') || 'schools-contact').trim(),
          }
        );

        if (submitBtn) submitBtn.disabled = false;

        if (result.ok) {
          form.reset();
          formFields?.classList.add('hidden');
          success?.classList.remove('hidden');
          success?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }

        showError(result.errorMessage || 'Something went wrong. Please try again.');
      });
    }
  }
</script>
