---
import Layout from '~/layouts/PageLayout.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import ServiceCards from '~/components/brand/ServiceCards.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import { ONE_LINERS } from '~/data/brand/copy';
import { TESTIMONIALS } from '~/data/brand/testimonials';
import { CTAS } from '~/data/brand/ctas';

const metadata = {
  title: 'AI Skills Training for Universities | WorkSmart-AI',
  description: ONE_LINERS.education,
  canonical: '/higher-education/',
};

const personas = [
  {
    title: 'PVC Education and the Strategy Office',
    body: 'You need AI capability at scale, aligned to institutional policy, with a clear return you can report.',
  },
  {
    title: 'L&D and Organisational Development',
    body: 'You need consistent, role-specific training for academic and professional services staff, measured against published outcomes.',
  },
  {
    title: 'Digital and IT',
    body: 'You need more staff using approved tools like Copilot well, and fewer using unapproved ones.',
  },
  {
    title: 'Student services and careers',
    body: 'You need students who know what is allowed in their studies and what employers expect.',
  },
];
---

<Layout metadata={metadata} sector="he">
  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-center lg:gap-12">
        <div class="w-full basis-1/2 pb-4 text-center lg:pb-0 lg:text-left">
          <h1
            class="mb-5 font-heading text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl"
          >
            AI skills training for <span class="text-[#FF7700]">universities</span>
          </h1>
          <p class="mb-8 max-w-xl font-sans text-lg leading-[1.7] text-white/85 lg:max-w-none">
            {ONE_LINERS.education}
          </p>
          <div
            class="mx-auto flex max-w-md flex-col gap-4 sm:flex-row sm:justify-center lg:mx-0 lg:max-w-none lg:justify-start"
          >
            <a
              href="/health-check/"
              class="inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
            >
              {CTAS.primary.text}
            </a>
          </div>
          <p class="mt-6 max-w-xl font-sans text-sm text-white/65 lg:max-w-none">
            A free, confidential 30-minute call and a written report you keep.
          </p>
        </div>
        <div class="w-full basis-1/2">
          <img
            src="/images/home-hero-photo.png"
            alt="Team collaborating around a table with sticky notes during a planning session"
            width={1200}
            height={800}
            loading="eager"
            decoding="async"
            class="mx-auto w-full rounded-2xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Digital Skills Leads banner -->
  <section class="bg-secondary px-6 py-6 sm:px-8 lg:px-12" no-intersect aria-label="Credibility and memberships">
    <div class="mx-auto max-w-6xl">
      <p class="max-w-3xl font-sans text-base font-medium leading-[1.7] text-[#015887] sm:text-lg">
        Founded by former Digital Skills Leads at the University of Exeter.<br />
        Members of the Staff Development Forum.
      </p>
    </div>
  </section>

  <!-- 3. Services -->
  <section class="bg-[#F8F8F8] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Services</p>
        <h2 id="services-heading" class="mt-3 font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          AI support designed for every part<br />
          of your institution
        </h2>
        <p class="mt-4 font-sans text-base leading-[1.7] text-[#1B0101]">
          Whether you need to lift staff capability, equip students for an AI-shaped workplace, coach an individual
          academic, or support your leadership team to lead adoption, we build it around your policy and tools.
        </p>
      </div>
      <div class="mt-12">
        <ServiceCards />
      </div>
      <div class="mt-16">
        <SectionHeader
          eyebrow="Courses"
          title="Courses for staff and students"
          subtitle="Run as workshops or online courses. Student courses are white-labelled only."
        />
        <CourseCards streams={['all-staff', 'academic', 'professional-services', 'students']} />
      </div>
      <div class="mt-10 text-center">
        <a href="/services/" class="font-heading text-sm font-bold text-[#015887] transition hover:text-[#FF7700]">
          See all our services <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Founder credibility -->
  <section class="bg-white px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="inside-he-heading">
    <div class="mx-auto flex max-w-6xl flex-col-reverse gap-10 md:flex-row md:items-center md:gap-16">
      <div class="md:basis-1/2">
        <h2 id="inside-he-heading" class="font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          We&rsquo;ve worked inside the buildings we&rsquo;re trying to help.
        </h2>
        <p class="mt-6 font-sans text-sm leading-[1.7] text-[#1B0101]">
          Both founders are former Digital Skills Leads at the University of Exeter, and higher education is our home
          sector. That context shapes every workshop we design and every conversation we have with your team.
        </p>
        <p class="mt-4 font-sans text-sm leading-[1.7] text-[#1B0101]">
          Understanding how universities operate and the technology used, means we can jump straight into helping you
          directly with your specific need.
        </p>
        <p class="mt-4 font-sans text-sm leading-[1.7] text-[#1B0101]">
          Appreciating the time, capacity and anxiety pressures that can exist, we use a people-first approach, to offer
          flexibility and support every step of the way.
        </p>
        <p class="mt-6 font-heading text-sm font-bold text-[#FF7700]">
          This isn&rsquo;t theory for us. It&rsquo;s the world we came from.
        </p>
        <a
          href="/about-us/"
          class="mt-8 inline-flex font-heading text-sm font-bold text-[#015887] transition hover:text-[#FF7700]"
        >
          Meet the team &rarr;
        </a>
      </div>
      <div class="md:basis-1/2">
        <img
          src="/images/team-photo.jpg"
          alt="WorkSmart-AI co-founders presenting at a conference to an audience"
          width={1200}
          height={900}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-lg object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 5. Who we work with -->
  <section class="bg-white px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="personas-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Who we work with</p>
        <h2 id="personas-heading" class="mt-3 font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          Built for the people who own AI adoption
        </h2>
        <p class="mt-4 font-sans text-base leading-[1.7] text-[#1B0101]">
          We work with the people tasked with turning AI curiosity into<br class="hidden sm:block" />
          institution-wide confidence, capability and compliance.
        </p>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          personas.map((persona) => (
            <article class="rounded-xl border border-[#E0E0E0] bg-white p-5 shadow-[0_6px_28px_-18px_rgba(1,88,135,0.25)]">
              <h3 class="font-heading text-lg font-bold leading-tight text-[#015887]">{persona.title}</h3>
              <p class="mt-3 font-sans text-sm leading-[1.65] text-[#1B0101]">{persona.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Quote banner -->
  <section
    class="bg-[#015887] px-6 py-8 sm:px-8 md:py-10 lg:px-12"
    no-intersect
    aria-label="What course participants say"
  >
    <div class="mx-auto max-w-3xl border-l-4 border-[#FF7700] pl-5 sm:pl-7">
      <blockquote>
        <p class="font-sans text-base font-bold leading-[1.7] text-white sm:text-lg">
          &ldquo;{TESTIMONIALS.lynch.quote}&rdquo;
        </p>
      </blockquote>
      <p class="mt-4 font-sans text-sm italic leading-[1.6] text-white/80">
        {TESTIMONIALS.lynch.name}, {TESTIMONIALS.lynch.role}
      </p>
    </div>
  </section>

  <!-- 8. Student AI literacy banner -->
  <section
    class="bg-[#015887] px-6 py-8 sm:px-8 md:py-10 lg:px-12"
    no-intersect
    aria-label="Student AI literacy evidence"
  >
    <div class="mx-auto max-w-3xl border-l-4 border-[#FF7700] pl-5 sm:pl-7">
      <blockquote>
        <p class="font-sans text-base font-bold leading-[1.7] text-white sm:text-lg">
          &ldquo;Students overwhelmingly see AI as essential for their futures, but many do not feel adequately
          supported to develop the necessary skills. If universities want graduates to feel prepared for the future,
          then AI literacy and capability must be embedded across the curriculum. These skills cannot be treated as
          optional.&rdquo;
        </p>
      </blockquote>
      <p class="mt-4 font-sans text-sm italic leading-[1.6] text-white/80">
        Charlotte Armstrong, Policy Manager, Higher Education Policy Institute - HEPI/Kortext Student Generative AI
        Survey 2026
      </p>
    </div>
  </section>

  <!-- 9. Testimonials -->
  <section class="bg-white px-6 py-12 sm:px-8 md:py-16 lg:px-12" no-intersect aria-label="Testimonials">
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2">
      {
        [TESTIMONIALS.harris, TESTIMONIALS.cordy].map((t) => (
          <figure class="flex h-full flex-col rounded-xl border border-[#E0E0E0] bg-white p-8 shadow-[0_6px_28px_-18px_rgba(1,88,135,0.25)]">
            <blockquote class="font-sans text-base leading-[1.7] text-[#1B0101] sm:text-lg">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-auto pt-4 font-sans text-sm italic text-gray-600">
              {t.name}, {t.role}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- 10. Final CTA -->
  <section class="bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="final-cta-heading">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">
        Where does your institution stand?
      </p>
      <h2 id="final-cta-heading" class="mt-3 font-heading text-3xl font-bold text-white sm:text-4xl">
        Book your free AI Capability Check
      </h2>
      <p class="mt-4 font-sans text-base leading-[1.7] text-white/75">
        A confidential 30-minute conversation, followed by a written report on where your teams sit on the AI Use
        Hierarchy and two or three next steps. No pitch, no slides, no obligation.
      </p>
      <a
        href="/health-check/"
        class="mt-8 inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
      >
        {CTAS.primary.text}
      </a>
    </div>
  </section>
</Layout>
