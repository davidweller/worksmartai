---
import ServicePage from '~/components/brand/ServicePage.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import HierarchyLadder from '~/components/brand/HierarchyLadder.astro';
import { priceOf } from '~/data/brand/services';

const workshopPrice = priceOf('Workshops and Events');
const coursePrice = priceOf('Online courses');

const metadata = {
  title: 'AI Staff Training Courses | WorkSmart-AI',
  description: `Practical, task-based AI training for all staff, academics and professional services, as workshops (${workshopPrice.toLowerCase()}) or online courses (${coursePrice.toLowerCase()}), built around your policy and tools.`,
  canonical: '/services/staff-training/',
};

const formats = [
  {
    title: 'As a workshop',
    price: workshopPrice,
    body: 'Face-to-face or online, from one hour to a full day, personalised to your sector and roles.',
    href: '/services/talks-workshops/',
  },
  {
    title: 'As an online course',
    price: coursePrice,
    body: 'Self-paced, hosted on the WorkSmart-AI Academy or white-labelled for your LMS.',
    href: '/services/your-own-ai-course/',
  },
];

const includes = [
  'Every course opens with a real task, with role-relevant value in the first ten minutes',
  'Built around your AI policy, Microsoft 365 and Copilot setup and data context',
  'Published learning outcomes for every course',
  'Compliance scenarios: spotting red flags and classifying tasks green, amber or red',
  'Mapped to the five-level AI Use Hierarchy, so staff see what comes next',
  'Academy courses report completion, assessment scores and confidence against the learning outcomes',
];
---

<ServicePage
  metadata={metadata}
  eyebrow="Staff training"
  title="Practical AI training for all your staff"
  intro="Task-based AI skills for all staff, academics and professional services, drawn from a bank of 290 use cases across 14 staff roles and built around your policy and tools."
  includesTitle="Every course"
  includes={includes}
  ctaTitle="Not sure where to start? Book a free AI Capability Check"
>
  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Course catalogue"
        title="Twelve courses in three streams"
        subtitle="Run any course as a workshop or an online course."
      />
      <div class="mb-12 grid gap-6 md:grid-cols-2">
        {
          formats.map((f) => (
            <a
              href={f.href}
              class="rounded-xl border border-primary/20 bg-card p-6 shadow-card transition hover:border-primary"
            >
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-heading text-xl font-bold text-heading">{f.title}</h3>
                <span class="font-heading font-bold text-primary">{f.price}</span>
              </div>
              <p class="mt-2 text-default">{f.body}</p>
            </a>
          ))
        }
      </div>
      <CourseCards streams={['all-staff', 'academic', 'professional-services']} />
    </div>
  </section>

  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="A structured path"
        title="The AI Use Hierarchy"
        subtitle="Capability, confidence and compliance are measured at every level."
      />
      <HierarchyLadder matrix />
    </div>
  </section>
</ServicePage>
