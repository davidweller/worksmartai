---
import ServicePage from '~/components/brand/ServicePage.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import { priceOf } from '~/data/brand/services';

const price = priceOf('Online courses');

const metadata = {
  title: 'Online AI Courses, Hosted or White-Labelled | WorkSmart-AI',
  description: `Self-paced AI courses for all staff or all students, hosted on the WorkSmart-AI Academy or white-labelled for your own LMS and built around your AI policy. ${price}.`,
  canonical: '/services/your-own-ai-course/',
};

const facts = [
  { value: '30-60 mins', label: 'Self-paced and interactive' },
  { value: '4 weeks', label: 'From receiving your AI policy' },
  { value: '12 months', label: 'Renewable licence' },
  { value: 'SCORM / xAPI', label: 'Or hosted on our Academy' },
];

const includes = [
  'Hosted on the WorkSmart-AI Academy, or white-labelled as SCORM or xAPI for your LMS',
  'Your branding, your AI and data policies, and the tools your staff are licensed to use',
  'Reflective tasks that turn learning into practice straight away',
  'Delivered within four weeks of receiving your AI policy',
  '12-month renewable licence, with content updated on renewal',
  'Certificate of completion',
  'Optional videos of your own senior staff or colleagues',
  'Reporting on every Academy course: completion, assessment scores and confidence against the learning outcomes',
];

const steps = [
  {
    title: 'AI Capability Check',
    body: 'A free 30-minute call to agree what the course needs to do, who it is for, and where it will sit.',
  },
  {
    title: 'You send your materials',
    body: 'Brand assets, your AI policy, your data protection position, any acceptable use guidance, and a named person to approve drafts.',
  },
  {
    title: 'We build, in four weeks',
    body: 'The clock starts when your policy arrives, not when the order is signed.',
  },
  {
    title: 'You launch',
    body: 'On our Academy, or as a SCORM or xAPI package for your LMS. On your own LMS, you hold the data.',
  },
];

const faqs = [
  {
    q: 'Will it look like ours?',
    a: 'Yes. A white-labelled course carries your colours, fonts and logo throughout, with your policies named in the text.',
  },
  {
    q: 'Can we host it ourselves?',
    a: 'Yes. You get a SCORM or xAPI package for your own LMS, and completion and progress data stays in your systems. Or we host it on the WorkSmart-AI Academy, which includes standard reporting.',
  },
  {
    q: 'Is it for staff or students?',
    a: 'Either. Courses are for all staff or all students, and work well as induction or mandatory training. Student training is offered as white-labelled courses only.',
  },
  {
    q: 'What if our policy changes?',
    a: 'Content is updated on renewal. If you expect bigger changes during the year, talk to us.',
  },
  {
    q: 'Do you charge VAT?',
    a: 'No. WorkSmart-AI is not VAT registered, so the price you see is the price you are invoiced.',
  },
];
---

<ServicePage
  metadata={metadata}
  eyebrow="Online courses"
  title="Your own AI course, built around your policy"
  intro="Self-paced, interactive AI courses for all staff or all students, hosted on the WorkSmart-AI Academy or white-labelled for your own LMS. Every course is built around your AI policy and the tools your people already use."
  price={price}
  facts={facts}
  includes={includes}
  faqs={faqs}
  ctaTitle="Start with a free AI Capability Check"
>
  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Course catalogue"
        title="Choose from our courses"
        subtitle="Every course has published learning outcomes and is mapped to the AI Use Hierarchy."
      />
      <CourseCards streams={['all-staff', 'academic', 'professional-services', 'students']} />
    </div>
  </section>

  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-5xl">
      <SectionHeader title="How it works" />
      <ol class="grid gap-5 md:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="rounded-xl border border-primary/20 bg-card p-5 shadow-card">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent text-sm font-bold text-white">
                {i + 1}
              </span>
              <h3 class="mt-3 font-heading font-bold text-heading">{step.title}</h3>
              <p class="mt-2 text-sm text-default">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</ServicePage>
