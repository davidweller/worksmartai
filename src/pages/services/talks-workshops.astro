---
import ServicePage from '~/components/brand/ServicePage.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import { priceOf } from '~/data/brand/services';

const price = priceOf('Workshops and Events');

const metadata = {
  title: 'AI Workshops and Events | WorkSmart-AI',
  description: `Face-to-face or online AI workshops from one hour to a full day: INSET, away days, team sessions, leadership workshops, keynotes and conference talks. ${price}.`,
  canonical: '/services/talks-workshops/',
};

const facts = [
  { value: '1 hour to a full day', label: 'Length set by you' },
  { value: 'In person or online', label: 'Wherever suits your team' },
  { value: 'Any catalogue topic', label: 'Personalised to sector and role' },
  { value: 'Free Check first', label: 'To set the right level' },
];

const sessionTypes = [
  {
    title: 'Workshops',
    description:
      'INSET, away days, team and departmental sessions on any topic from our course catalogue, personalised to your sector and roles, including professional services, academic and researcher roles. Copilot training from foundation through to advanced.',
  },
  {
    title: 'Leadership workshops',
    description:
      'The AI Leadership Briefing and The AI Strategic Roadmap, for senior teams who want a shared view of where AI fits and a plan they will own.',
  },
  {
    title: 'Talks and events',
    description:
      'Keynotes and conference talks, one-off sessions and leadership away days, tailored to the audience so the room leaves with something it can act on.',
  },
];
---

<ServicePage
  metadata={metadata}
  eyebrow="Workshops and Events"
  title="AI workshops, talks and away days"
  intro="Face-to-face or online, from one hour to a full day, for universities, colleges, schools and organisations. Every session is built around real tasks, your policy and the tools your people already use."
  price={price}
  facts={facts}
  ctaTitle="Planning a session? Start with a free AI Capability Check"
  ctaSubtitle="A 30-minute call that places your team on the AI Use Hierarchy, so the workshop starts at the right level."
>
  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
      {
        sessionTypes.map((t) => (
          <div class="rounded-xl border border-primary/20 bg-card p-6 shadow-card">
            <h2 class="font-heading text-xl font-bold text-heading">{t.title}</h2>
            <p class="mt-3 text-default">{t.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Workshop topics"
        title="Choose from our catalogue"
        subtitle="Any course topic can be run as a workshop, alongside our two leadership workshops."
      />
      <CourseCards streams={['leadership', 'all-staff', 'academic', 'professional-services']} />
    </div>
  </section>
</ServicePage>
