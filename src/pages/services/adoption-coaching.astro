---
import ServicePage from '~/components/brand/ServicePage.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import { priceOf } from '~/data/brand/services';

const price = priceOf('AI adoption coaching');

const metadata = {
  title: 'Adoption Coaching for Senior Leaders | WorkSmart-AI',
  description: `One-to-one or small-group coaching for senior leaders leading AI adoption: strategy, policy and a phased adoption roadmap, from education specialists. ${price}.`,
  canonical: '/services/adoption-coaching/',
};

const includes = [
  'One-to-one or one-to-few, for leaders who would rather not ask questions in front of colleagues',
  'Change management for AI and digital skills: strategy, policy and a phased adoption roadmap',
  'Regular touch-base support, online or face-to-face',
  'Optional full capability review of your staff',
  'Optional consultation on your strategic approach to staff engagement',
  'Optional filmed video testimonials',
];

const faqs = [
  {
    q: 'Who is it for?',
    a: 'Senior leaders responsible for AI adoption in a university, college, school or trust, or organisation: vice-chancellors and their teams, principals, heads, directors and service leads.',
  },
  {
    q: 'Is it confidential?',
    a: 'Yes. Sessions are one-to-one or with a small group you choose, so you can ask the questions you would rather not ask in a wider meeting.',
  },
  {
    q: 'Are you tied to any vendor?',
    a: 'No. We don’t sell or implement software or licences. We help you get the most from the tools you have.',
  },
  {
    q: 'How do we start?',
    a: 'With a free AI Capability Check. It places your teams on the AI Use Hierarchy and gives you two or three next steps, which usually shape the first coaching sessions.',
  },
];
---

<ServicePage
  metadata={metadata}
  eyebrow="Adoption coaching"
  title="Lead AI adoption with confidence"
  intro="Coaching for senior leaders on leading AI adoption: the strategy, the policy and a phased roadmap, with someone who has done it inside education. One-to-one or with a few trusted colleagues."
  price={price}
  includes={includes}
  faqs={faqs}
  ctaTitle="Start with a free AI Capability Check"
>
  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        title="Leadership workshops"
        subtitle="Prefer to work as a group? Our two leadership workshops are run as part of Workshops and Events."
      />
      <CourseCards streams={['leadership']} />
      <p class="mt-6 text-center">
        <a href="/services/talks-workshops/" class="font-semibold text-link underline underline-offset-4"
          >See Workshops and Events</a
        >
      </p>
    </div>
  </section>
</ServicePage>
