---
import ServicePage from '~/components/brand/ServicePage.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import { STUDENT_VARIANTS } from '~/data/brand/courses';
import { CTAS } from '~/data/brand/ctas';

const metadata = {
  title: 'AI Courses for Students | WorkSmart-AI',
  description: `White-labelled AI courses for all students, in your branding and built around your AI policy: AI Skills for Employability, and a student version of AI Foundations and Responsible Use.`,
  canonical: '/services/student-training/',
};

const facts = [
  { value: 'All students', label: 'One licence, any headcount' },
  { value: 'Your branding', label: 'White-labelled' },
  { value: 'SCORM / xAPI', label: 'For your own LMS' },
  { value: '12 months', label: 'Renewable licence' },
];

const includes = [
  'White-labelled in your branding, built around your AI and academic integrity policies',
  'Delivered as SCORM or xAPI for your own LMS',
  'Self-paced and interactive, usable as induction or mandatory training',
  'Delivered within four weeks of receiving your AI policy',
  '12-month renewable licence, with content updated on renewal',
  'Certificate of completion',
];
---

<ServicePage
  metadata={metadata}
  eyebrow="Student courses"
  title={`AI skills every student can use,\nin your own course`}
  intro={`White-labelled online courses for all students, built around your policy,\nso every student knows what’s allowed and what employers expect.`}
  facts={facts}
  includes={includes}
  ctaTitle="Start with a free AI Capability Check"
>
  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader title="The student courses" />
      <CourseCards streams={['students']} variants={STUDENT_VARIANTS} />
      <div class="mt-10 flex justify-center">
        <a
          href={CTAS.quote.href}
          class="inline-flex items-center justify-center rounded-full bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#e55f00]"
        >
          {CTAS.quote.text}
        </a>
      </div>
    </div>
  </section>
</ServicePage>
