---
import ServicePage from '~/components/brand/ServicePage.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import EvidenceStats from '~/components/brand/EvidenceStats.astro';
import { priceOf } from '~/data/brand/services';
import { EVIDENCE } from '~/data/brand/evidence';

const price = priceOf('Online courses');

const metadata = {
  title: 'AI Courses for Students | WorkSmart-AI',
  description: `White-labelled AI courses for all students, in your branding and built around your AI policy: AI Foundations and Responsible Use, and AI Skills for the Workplace. ${price}.`,
  canonical: '/services/student-training/',
};

const facts = [
  { value: '2 courses', label: 'For all students' },
  { value: 'Your branding', label: 'White-labelled' },
  { value: 'SCORM / xAPI', label: 'For your own LMS' },
  { value: '12 months', label: 'Renewable licence' },
];

const includes = [
  'White-labelled in your branding, built around your AI and academic integrity policies',
  'Delivered as SCORM or xAPI for your own LMS',
  'Self-paced and interactive, usable as induction or mandatory training',
  'Delivered within four weeks of receiving your AI policy',
  '12-month renewable licence, with content updated on renewal',
  'Certificate of completion',
];
---

<ServicePage
  metadata={metadata}
  eyebrow="Student courses"
  title="AI skills every student can use, in your own course"
  intro="Two white-labelled online courses for all students, built around your policy, so every student knows what’s allowed and what employers expect."
  price={price}
  facts={facts}
  includes={includes}
  ctaTitle="Start with a free AI Capability Check"
>
  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader title="The student courses" />
      <CourseCards streams={['students']} />
    </div>
  </section>

  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-4xl">
      <SectionHeader title="Why students need it" />
      <EvidenceStats items={[EVIDENCE.studentSkills]} />
    </div>
  </section>
</ServicePage>
