---
import { Icon } from 'astro-icon/components';
import ServicePage from '~/components/brand/ServicePage.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import { priceOf } from '~/data/brand/services';

const price = priceOf('Academic coaching');

const metadata = {
  title: 'Academic Coaching | WorkSmart-AI',
  description: `Discipline and role-specific AI coaching for academics and research teams: research, writing, grant work and teaching preparation. One-to-one or groups of up to six. ${price}.`,
  canonical: '/services/academic-coaching/',
};

const coachingAreas = [
  { title: 'Research and literature review', icon: 'tabler:search' },
  { title: 'Academic writing and publishing', icon: 'tabler:writing' },
  { title: 'Grant and funding applications', icon: 'tabler:coin-pound' },
  { title: 'Teaching preparation and course design', icon: 'tabler:presentation' },
  { title: 'Marking and assessment feedback', icon: 'tabler:checklist' },
  { title: 'Presenting and communicating research', icon: 'tabler:microphone' },
];

const includes = [
  'Discipline and role-specific: research, writing, grant work, teaching preparation',
  'One-to-one, or groups of up to six',
  'A four-session starter package, then monthly',
  'Hands-on work with your real tasks and documents',
  'Sessions online or face-to-face, scheduled around teaching',
];
---

<ServicePage
  metadata={metadata}
  eyebrow="Academic coaching"
  title="AI coaching for academics and research teams"
  intro="Coaching shaped around your discipline and your role, working on your real research, writing, grant and teaching tasks. One-to-one or in groups of up to six."
  price={price}
  includes={includes}
  ctaTitle="Start with a free AI Capability Check"
>
  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-5xl">
      <SectionHeader title="What we coach" />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          coachingAreas.map((a) => (
            <li class="flex items-center gap-3 rounded-xl border border-primary/20 bg-card p-5 shadow-card">
              <Icon name={a.icon} class="h-6 w-6 shrink-0 text-primary" aria-hidden="true" />
              <span class="font-heading font-bold text-heading">{a.title}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</ServicePage>
