---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'AI Skills Training for Organisations | WorkSmart-AI',
  description:
    'Practical AI skills training for companies, councils and public bodies, built around your tools and data policy. Plus AI skills cohorts for local employer skills programmes.',
  canonical: '/business/',
};

const strands = [
  {
    eyebrow: 'Your staff',
    title: 'Train your own teams',
    who: 'SMEs, larger companies, charities, councils, NHS trusts',
    points: [
      'All-staff AI courses and Copilot rollout',
      'Leadership briefings for senior teams',
      "Built around your data policy, so staff know what's safe",
    ],
    note: 'From £2,995 per cohort of up to 25. For public bodies, a workshop sits below tender thresholds and can be bought on a purchase order.',
    cta: 'Book a 20-minute call',
  },
  {
    eyebrow: 'Skills programmes',
    title: 'AI skills for local employers',
    who: 'Chambers of Commerce, LSIP partners, Combined Authorities and councils running funded skills programmes',
    points: [
      'We deliver AI skills cohorts to SMEs and their staff',
      'Reporting against your programme outcomes',
      "Impact report mapped to each course's learning outcomes",
    ],
    note: null,
    cta: 'Talk to us about a programme',
  },
];

const courses = [
  { title: 'AI Foundations & Responsible Use', level: 'Foundation' },
  { title: 'AI for Daily Workflows', level: 'Foundation to Intermediate' },
  { title: 'Copilot Chat to 365 Copilot', level: 'Foundation' },
  { title: 'Build Custom AI Agents', level: 'Intermediate' },
  { title: 'AI for Process Improvement', level: 'Up to Intermediate' },
];
---

<Layout metadata={metadata} sector="neutral">
  <!-- 1. Hero -->
  <section class="bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-4xl text-center lg:text-left">
      <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Businesses</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        AI skills training for <span class="text-[#FF7700]">your organisation</span>
      </h1>
      <p class="mt-5 max-w-2xl font-sans text-lg leading-[1.7] text-white/85">
        For companies, councils and public bodies: the same practical courses we run for universities, built around your
        tools and policies.
      </p>
      <a
        href="/contact-us/"
        class="mt-8 inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
      >
        Book a 20-minute call
      </a>
    </div>
  </section>

  <!-- 2. Two strands -->
  <section class="bg-[#F8F8F8] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Services</p>
        <h2 id="services-heading" class="mt-3 font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          What we do for organisations
        </h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          strands.map((strand) => (
            <div class="flex h-full flex-col rounded-xl border border-[#E0E0E0] bg-white p-8 shadow-[0_6px_28px_-18px_rgba(1,88,135,0.25)]">
              <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">
                {strand.eyebrow}
              </p>
              <h3 class="mt-2 font-heading text-2xl font-bold leading-tight text-[#015887]">{strand.title}</h3>
              <p class="mt-3 font-sans text-sm leading-[1.65] text-gray-600">{strand.who}</p>
              <ul class="mt-5 space-y-3">
                {strand.points.map((point) => (
                  <li class="flex items-start gap-3 font-sans text-base leading-[1.6] text-[#1B0101]">
                    <Icon name="tabler:check" class="mt-1 h-4 w-4 shrink-0 text-[#015887]" aria-hidden="true" />
                    {point}
                  </li>
                ))}
              </ul>
              {strand.note && <p class="mt-5 font-sans text-sm leading-[1.65] text-gray-600">{strand.note}</p>}
              <div class="mt-auto pt-6">
                <a
                  href="/contact-us/"
                  class="inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-6 py-2.5 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
                >
                  {strand.cta}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Courses -->
  <section class="bg-white px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="courses-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Courses</p>
        <h2 id="courses-heading" class="mt-3 font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          Where most teams start
        </h2>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          courses.map((course) => (
            <li class="flex flex-col gap-3 rounded-xl border border-[#E0E0E0] border-l-4 border-l-[#86BFE2] bg-white p-6">
              <h3 class="font-heading text-lg font-bold leading-tight text-[#015887]">{course.title}</h3>
              <span class="self-start rounded-full border border-[#E0E0E0] px-3 py-0.5 font-sans text-xs text-gray-600">
                {course.level}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/roi-calculator/"
          class="inline-flex items-center justify-center rounded-full border-2 border-[#015887] px-6 py-2.5 font-heading text-sm font-bold text-[#015887] transition hover:bg-[#015887] hover:text-white"
        >
          ROI calculator
        </a>
        <a
          href="/copilot-licensing/"
          class="inline-flex items-center justify-center rounded-full border-2 border-[#015887] px-6 py-2.5 font-heading text-sm font-bold text-[#015887] transition hover:bg-[#015887] hover:text-white"
        >
          Copilot licensing guide
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Final CTA -->
  <section class="bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="final-cta-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="final-cta-heading" class="font-heading text-3xl font-bold text-white sm:text-4xl">
        Not sure where your teams are starting from?
      </h2>
      <p class="mt-4 font-sans text-base leading-[1.7] text-white/75">
        A short conversation about your organisation, your tools and your data policy. No pitch, no obligation.
      </p>
      <a
        href="/contact-us/"
        class="mt-8 inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
      >
        Book a 20-minute call
      </a>
    </div>
  </section>
</Layout>
