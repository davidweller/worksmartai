---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import CtaBand from '~/components/brand/CtaBand.astro';
import { ONE_LINERS } from '~/data/brand/copy';
import { CTAS } from '~/data/brand/ctas';
import { priceOf } from '~/data/brand/services';

const metadata = {
  title: 'AI Skills Training for Businesses and the Public Sector | WorkSmart-AI',
  description: ONE_LINERS.business,
  canonical: '/business/',
};

const strands = [
  {
    eyebrow: 'Your staff',
    title: 'Train your own teams',
    who: 'SMEs, larger companies, charities, councils and public bodies',
    points: [
      'All-staff AI courses and Copilot rollout, so you get more from the licences you pay for',
      'Leadership workshops and adoption coaching for senior teams',
      "Built around your data policy, so staff know what's safe",
    ],
    note: `Workshops ${priceOf('Workshops and Events').toLowerCase()}; online courses ${priceOf('Online courses').toLowerCase()}.`,
    cta: CTAS.primary.text,
    href: CTAS.primary.href,
  },
  {
    eyebrow: 'AI adoption',
    title: 'Put AI to work in your organisation',
    who: 'Owners, directors and senior teams leading AI adoption',
    points: [
      'Find where AI can benefit your organisation most',
      'Coaching on strategy, policy and a phased adoption roadmap',
      'Build your workflows for quick implementation',
    ],
    note: `Adoption coaching ${priceOf('AI adoption coaching').toLowerCase()}.`,
    cta: 'See adoption coaching',
    href: '/services/adoption-coaching/',
  },
  {
    eyebrow: 'Skills programmes',
    title: 'AI skills for local employers',
    who: 'Chambers of Commerce, LSIP partners, Combined Authorities and councils running funded skills programmes',
    points: [
      'We deliver AI skills cohorts to SMEs and their staff',
      'Every course has published learning outcomes',
      'Academy courses report completion, assessment scores and confidence against them',
    ],
    note: null,
    cta: 'Talk to us about a programme',
    href: '/contact-us/',
  },
];
---

<Layout metadata={metadata} sector="neutral">
  <!-- 1. Hero -->
  <section class="bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-4xl text-center lg:text-left">
      <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">
        Businesses and public sector
      </p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        AI skills training for <span class="text-[#FF7700]">your organisation</span>
      </h1>
      <p class="mt-5 max-w-2xl font-sans text-lg leading-[1.7] text-white/85">
        {ONE_LINERS.business}
      </p>
      <a
        href={CTAS.primary.href}
        class="mt-8 inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
      >
        {CTAS.primary.text}
      </a>
    </div>
  </section>

  <!-- 2. Two strands -->
  <section class="bg-[#F8F8F8] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Services</p>
        <h2 id="services-heading" class="mt-3 font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          What we do for organisations
        </h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          strands.map((strand) => (
            <div class="flex h-full flex-col rounded-xl border border-[#E0E0E0] bg-white p-8 shadow-[0_6px_28px_-18px_rgba(1,88,135,0.25)]">
              <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">
                {strand.eyebrow}
              </p>
              <h3 class="mt-2 font-heading text-2xl font-bold leading-tight text-[#015887]">{strand.title}</h3>
              <p class="mt-3 font-sans text-sm leading-[1.65] text-gray-600">{strand.who}</p>
              <ul class="mt-5 space-y-3">
                {strand.points.map((point) => (
                  <li class="flex items-start gap-3 font-sans text-base leading-[1.6] text-[#1B0101]">
                    <Icon name="tabler:check" class="mt-1 h-4 w-4 shrink-0 text-[#015887]" aria-hidden="true" />
                    {point}
                  </li>
                ))}
              </ul>
              {strand.note && <p class="mt-5 font-sans text-sm leading-[1.65] text-gray-600">{strand.note}</p>}
              <div class="mt-auto pt-6">
                <a
                  href={strand.href}
                  class="inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-6 py-2.5 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
                >
                  {strand.cta}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Courses -->
  <section class="bg-white px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Courses"
        title="Where most teams start"
        subtitle="Run as workshops or online courses, built around your tools and policy."
      />
      <CourseCards streams={['all-staff', 'professional-services']} labels={false} />
    </div>
  </section>

  <CtaBand title="Not sure where your teams are starting from?" />
</Layout>
