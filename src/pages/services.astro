---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import ServiceCards from '~/components/brand/ServiceCards.astro';
import UpsellLadder from '~/components/brand/UpsellLadder.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import CtaBand from '~/components/brand/CtaBand.astro';
import { ONE_LINERS, WHAT_WE_DONT_DO } from '~/data/brand/copy';
import { ADD_ONS } from '~/data/brand/services';

const metadata = {
  title: 'AI Training Services and Prices | WorkSmart-AI',
  description:
    'The AI Capability Check, workshops and events, online courses, adoption coaching and academic coaching, with from-prices. Built around your people, policy and tools.',
  canonical: '/services/',
};

const faqItems = [
  {
    title: 'What makes WorkSmart-AI different from other AI training providers?',
    description:
      'We are education specialists: both founders are former Digital Skills Leads at the University of Exeter. Every course opens with a real task, is built around your policy and tools, and has published learning outcomes, so you can see what your training delivered.',
  },
  {
    title: 'Who are your services for?',
    description:
      'Universities, colleges, schools and trusts, businesses and the public sector, including councils, public bodies, SMEs and charities.',
  },
  {
    title: 'How do you personalise training?',
    description:
      'Every engagement starts with a free AI Capability Check, which places your team on the AI Use Hierarchy. We then build workshops and courses around your AI policy, your Microsoft 365 and Copilot setup, and your roles.',
  },
  {
    title: 'What do the prices mean?',
    description:
      'Every price is shown from the lowest level, for example a one-hour workshop or a one-hour course. We publish topics and formats, then quote each engagement once we know what you need.',
  },
];
---

<Layout metadata={metadata}>
  <section class="bg-brand px-6 py-16 sm:px-8 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-4 text-sm font-semibold text-secondary sm:text-base">What we offer</p>
      <h1 class="font-heading text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
        AI training, coaching and consultancy
      </h1>
      <p class="mt-6 text-base leading-[var(--aw-leading-body,1.7)] text-white/90 sm:text-lg">{ONE_LINERS.generic}</p>
    </div>
  </section>

  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12 lg:py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        title="Published topics and formats, built around you"
        subtitle="Every price is shown from the lowest level, for example a one-hour workshop or a one-hour course."
      />
      <ServiceCards variant="rows" />
    </div>
  </section>

  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        title="Start small, build from there"
        subtitle="Most organisations start with the free AI Capability Check, then build up as their people do."
      />
      <UpsellLadder />
      <div class="mt-10 rounded-xl border border-primary/20 bg-card p-6 shadow-card">
        <h3 class="font-heading text-lg font-bold text-heading">Add-ons</h3>
        <ul class="mt-3 flex flex-col gap-2 sm:flex-row sm:gap-8">
          {
            ADD_ONS.map((a) => (
              <li class="flex items-center gap-2 text-default">
                <Icon name="tabler:plus" class="h-4 w-4 text-accent" aria-hidden="true" />
                {a}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-section px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        title="Fourteen courses in four streams"
        subtitle="Run as workshops or online courses. Student courses are white-labelled online courses only."
      />
      <CourseCards streams={['all-staff', 'academic', 'professional-services', 'students']} />
    </div>
  </section>

  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-3xl">
      <SectionHeader title="What we don’t do" />
      <ul class="space-y-3">
        {
          WHAT_WE_DONT_DO.map((line) => (
            <li class="flex items-start gap-3 text-default">
              <Icon name="tabler:x" class="mt-1 h-5 w-5 shrink-0 text-accent" aria-hidden="true" />
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FAQs title="FAQs" columns={1} items={faqItems} />

  <CtaBand />
</Layout>
