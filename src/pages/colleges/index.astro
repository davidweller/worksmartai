---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'AI Skills Training for Further Education | WorkSmart-AI',
  description:
    'Practical AI training for college teaching staff, support staff and leaders, and AI skills for your learners. Built around your AI policy by people who have worked inside education.',
  canonical: '/colleges/',
};

const serviceItems = [
  {
    title: 'Staff training',
    description:
      '3-hour workshops and 60-minute online courses for teaching and support staff, built around your AI policy so staff know what is safe to use and how.',
    icon: 'tabler:users',
    href: '/services/staff-training/',
  },
  {
    title: 'Learner programmes',
    description:
      'AI foundations and AI for the workplace, for learners heading into work, apprenticeships or higher study.',
    icon: 'tabler:school',
    href: '/services/student-training/',
  },
  {
    title: 'Your own AI course',
    description: "Our online course in your college's branding, on your LMS, built around your AI policy.",
    icon: 'tabler:certificate',
    href: '/services/your-own-ai-course/',
  },
  {
    title: 'Leadership briefing',
    description: "For senior leaders and governors setting the college's AI direction, risk position and priorities.",
    icon: 'tabler:crown',
    href: '/services/senior-consulting/',
  },
];

const courses = [
  { title: 'AI Foundations & Responsible Use (Staff)', level: 'Foundation' },
  { title: 'AI for Daily Workflows', level: 'Foundation to Intermediate' },
  { title: 'AI Foundations & Responsible Use (Student)', level: 'Foundation' },
  { title: 'AI for the Workplace', level: 'Foundation' },
];
---

<Layout metadata={metadata} sector="neutral">
  <!-- 1. Hero -->
  <section class="bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-4xl text-center lg:text-left">
      <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Colleges</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        AI skills for <span class="text-[#FF7700]">further education</span>
      </h1>
      <p class="mt-5 max-w-2xl font-sans text-lg leading-[1.7] text-white/85">
        Practical AI training for teaching staff, support staff and leaders, and AI skills for your learners.
      </p>
      <a
        href="/contact-us/"
        class="mt-8 inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
      >
        Book a 20-minute call
      </a>
    </div>
  </section>

  <!-- 2. Services -->
  <section class="bg-[#F8F8F8] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Services</p>
        <h2 id="services-heading" class="mt-3 font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          What we do for colleges
        </h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          serviceItems.map((service) => (
            <a
              href={service.href}
              class="group flex h-full flex-col rounded-xl border border-[#E0E0E0] bg-white p-6 shadow-[0_6px_28px_-18px_rgba(1,88,135,0.25)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_-22px_rgba(1,88,135,0.45)]"
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#E6F1FB] text-[#015887]">
                <Icon name={service.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="mt-5 font-heading text-xl font-bold leading-tight text-[#015887]">{service.title}</h3>
              <p class="mt-3 flex-1 font-sans text-sm leading-[1.65] text-[#1B0101]">{service.description}</p>
              <span class="mt-6 inline-flex items-center font-heading text-sm font-bold text-[#FF7700]">
                Learn more{' '}
                <span class="ml-1 transition-transform group-hover:translate-x-1" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Courses -->
  <section class="bg-white px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="courses-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Courses</p>
        <h2 id="courses-heading" class="mt-3 font-heading text-3xl font-bold text-[#015887] sm:text-4xl">
          Where most colleges start
        </h2>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          courses.map((course) => (
            <li class="flex flex-col gap-3 rounded-xl border border-[#E0E0E0] border-l-4 border-l-[#86BFE2] bg-white p-6">
              <h3 class="font-heading text-lg font-bold leading-tight text-[#015887]">{course.title}</h3>
              <span class="self-start rounded-full border border-[#E0E0E0] px-3 py-0.5 font-sans text-xs text-gray-600">
                {course.level}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Final CTA -->
  <section class="bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect aria-labelledby="final-cta-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="final-cta-heading" class="font-heading text-3xl font-bold text-white sm:text-4xl">
        Not sure where your staff are starting from?
      </h2>
      <p class="mt-4 font-sans text-base leading-[1.7] text-white/75">
        A short conversation about your college, your AI policy and your learners. No pitch, no obligation.
      </p>
      <a
        href="/contact-us/"
        class="mt-8 inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
      >
        Book a 20-minute call
      </a>
    </div>
  </section>
</Layout>
