---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import ServiceCards from '~/components/brand/ServiceCards.astro';
import CourseCards from '~/components/brand/CourseCards.astro';
import CtaBand from '~/components/brand/CtaBand.astro';
import { ONE_LINERS } from '~/data/brand/copy';
import { CTAS } from '~/data/brand/ctas';

const metadata = {
  title: 'AI Skills Training for Colleges | WorkSmart-AI',
  description:
    'Practical AI training for college teaching and support staff, and white-labelled AI courses for learners, built around your AI policy so responsible use is inspection-ready.',
  canonical: '/colleges/',
};

const concerns = [
  {
    title: 'Practical skills, not demos',
    body: 'Every course opens with a real task your staff already do, so the value shows in the first ten minutes.',
    icon: 'tabler:tool',
  },
  {
    title: 'Inspection-ready responsible use',
    body: 'Training built around your own AI policy, with compliance scenarios so staff can show they know it.',
    icon: 'tabler:shield-check',
  },
  {
    title: 'Learners ready for work',
    body: 'White-labelled courses so every learner knows what is allowed in their studies and what employers expect.',
    icon: 'tabler:briefcase',
  },
];
---

<Layout metadata={metadata} sector="neutral">
  <section class="bg-[#015887] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-4xl text-center lg:text-left">
      <p class="font-heading text-[11px] font-bold uppercase tracking-[0.2em] text-[#FF7700]">Colleges</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        AI skills for <span class="text-[#FF7700]">further education</span>
      </h1>
      <p class="mt-5 max-w-2xl font-sans text-lg leading-[1.7] text-white/85">{ONE_LINERS.education}</p>
      <p class="mt-4 max-w-2xl font-sans text-base text-[#B6DCF4]">
        For principals, L&amp;D and digital leads, and the teaching and support staff they look after.
      </p>
      <a
        href={CTAS.primary.href}
        class="mt-8 inline-flex items-center justify-center rounded-full border border-[#FF7700] bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-[#e55f00] hover:bg-[#e55f00]"
      >
        {CTAS.primary.text}
      </a>
    </div>
  </section>

  <section class="bg-white px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
      {
        concerns.map((c) => (
          <div>
            <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-[#E6F1FB] text-[#015887]">
              <Icon name={c.icon} class="h-6 w-6" aria-hidden="true" />
            </span>
            <h2 class="font-heading text-xl font-bold text-[#015887]">{c.title}</h2>
            <p class="mt-2 font-sans leading-[1.65] text-[#1B0101]">{c.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-[#F8F8F8] px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader eyebrow="Services" title="What we do for colleges" />
      <ServiceCards />
    </div>
  </section>

  <section class="bg-white px-6 py-12 sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Courses"
        title="Where most colleges start"
        subtitle="Staff courses run as workshops or online courses. Learner courses are white-labelled online courses."
      />
      <CourseCards streams={['all-staff', 'students']} />
    </div>
  </section>

  <CtaBand title="Not sure where your staff are starting from?" />
</Layout>
