---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { ONE_LINERS } from '~/data/brand/copy';
import { CTAS } from '~/data/brand/ctas';

const metadata = {
  title: 'About WorkSmart-AI and Our Founders | WorkSmart-AI',
  description:
    'Meet the founders of WorkSmart-AI, former Digital Skills Leads at the University of Exeter, and how decades in education shape practical, people-first AI training.',
  canonical: '/about-us/',
};

const founderCards = [
  {
    name: 'Katie Steen',
    image: '/images/founders/katie-steen.png',
    linkedin: 'https://www.linkedin.com/in/katiesteen/',
    paragraphs: [
      "I'm all about the people! I've spent much of the last twenty years focusing on education through the lens of a camera - filming educational online training videos within UK schools for the government-funded channel Teachers' TV. Over a 6-year period I worked with over 200 primary and secondary schools, trusts and local authority partners.",
      'This was followed by a further 6 years working internationally, filming educational and social programming for organisations such as the British Council and the United Nations. Meeting amazing people, promoting their work and helping affect change.',
      'Since 2017 my focus has been within higher education, supporting professional service and academic staff to digitally upskill - most recently with AI.',
      "It was during my last role at the University of Exeter that I met Dave when we co-created and led the institution's Digital Skills Initiative - providing training and guidance to 7,500 staff.",
      'And from this work, our company WorkSmart-AI was born!',
      "And in my spare time I'm delighted to support my local primary as a school governor",
    ],
  },
  {
    name: 'David Weller',
    image: '/images/founders/david-weller.png',
    linkedin: 'https://www.linkedin.com/in/davidrweller/',
    paragraphs: [
      "I've spent over twenty years exploring how technology can make learning more human. From classrooms to boardrooms, I've always been fascinated by how the right tools can build confidence, creativity, and capability in people. Along the way I've gained a Master's degree in Education and a postgraduate diploma in teaching.",
      "Much of that journey has been spent training teachers. As a TESOL teacher trainer, I've helped educators around the world develop their practice and grow in confidence, work that taught me how people actually learn new skills and what it takes to make change stick. That experience now sits at the heart of how WorkSmart-AI approaches AI training: practical, people-first, and built on sound pedagogy.",
      'My work has taken me from teaching, examining, and teacher training to leading large-scale digital upskilling programmes - most recently as Digital Skills Lead at the University of Exeter',
      "I'm passionate about turning innovation into something practical - helping organisations not just adopt technology, but use it to work smarter and create real results. That's what brought Katie and me together to found WorkSmart-AI, to help people thrive in the AI era, one confident learner at a time.",
    ],
  },
];
---

<Layout metadata={metadata}>
  <HeroText title="People are at the heart of everything we do" subtitle={ONE_LINERS.generic} />

  <section class="bg-section px-6 pb-16 sm:px-8 lg:px-12">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div class="overflow-hidden rounded-2xl bg-card shadow-card ring-1 ring-border">
        <iframe
          title="WorkSmart-AI company video"
          src="https://www.youtube.com/embed/2vSpg6NhX40?feature=oembed"
          class="aspect-video w-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
      <div class="rounded-2xl bg-card p-8 shadow-card ring-1 ring-border">
        <h2 class="font-heading text-3xl font-bold text-heading">Our approach</h2>
        <p class="mt-4 leading-relaxed text-muted">
          With decades of specialist educational experience between us, we understand the value of working closely with
          each organisation to personalise every course and workshop we deliver.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          People are at the heart of everything that we do, as only once people feel confident and engaged in an
          experience, does real learning take place.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          This is demonstrated by our hands-on, personalised approach towards training and our uncomplicated,
          transparent and proactive approach towards business.
        </p>
        <p class="mt-4 font-semibold text-heading">
          Ultimately if the learning is fun, then great things can be achieved!
        </p>
      </div>
    </div>
  </section>

  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <div class="text-center">
        <h2 class="font-heading text-3xl font-bold text-heading sm:text-4xl">Meet Our Founders</h2>
      </div>
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        {
          founderCards.map((founder) => (
            <article class="rounded-2xl bg-card p-6 shadow-card ring-1 ring-border sm:p-8">
              <img src={founder.image} alt={founder.name} class="mx-auto h-52 w-52 rounded-2xl object-cover" />
              <p class="mt-3 text-center text-sm font-semibold text-accent">Founder of WorkSmart-AI</p>
              <h3 class="mt-2 text-center font-heading text-2xl font-bold text-heading">{founder.name}</h3>
              <div class="mt-5 space-y-4 text-muted">
                {founder.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <a
                href={founder.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex font-semibold text-link underline decoration-secondary underline-offset-4 hover:text-link-hover"
              >
                LinkedIn
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Features2
    title="What this means for you"
    columns={3}
    items={[
      {
        title: 'Personalised training',
        description: 'Every course is built around your people, your AI policy and the tools you already use.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'People-first learning',
        description: 'Only once people feel confident and engaged in an experience does real learning take place.',
        icon: 'tabler:users',
      },
      {
        title: 'Transparent delivery',
        description: 'We bring an uncomplicated, transparent and proactive approach towards business.',
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <CallToAction
    title="Reach out!"
    subtitle="Interested in how WorkSmart-AI could help your staff become more capable, confident and compliant with AI? Start with a free 30-minute AI Capability Check, or get in touch to say hello."
    actions={[
      { variant: 'primary', text: CTAS.primary.text, href: CTAS.primary.href },
      { text: 'Contact us', href: '/contact-us/' },
    ]}
  />
</Layout>
