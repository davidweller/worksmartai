---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'AI capability for education | WorkSmart-AI',
  description:
    'Practical AI capability for universities and schools. Confident staff, clear guardrails, and real outcomes - built by people who have worked inside education.',
  canonical: '/',
};

const credibilityMarkers = [
  'Members of the Staff Development Forum',
  'Members of the Association of Learning Technology',
];

const frameworks = [
  {
    title: 'The AI Use Hierarchy',
    body: 'Six clear levels of AI skill, so staff know where they are and what comes next. No more guessing who can do what.',
    icon: 'tabler:stairs-up',
  },
  {
    title: 'AI decision matrix',
    body: 'A simple test staff apply in seconds: what is safe to put into an AI tool, and what is not.',
    icon: 'tabler:traffic-lights',
  },
  {
    title: 'Outcomes you can measure',
    body: 'Hours saved per person per week, tracked and reported. Capability you can show your board, not just hope for.',
    icon: 'tabler:chart-bar',
  },
];

const sectorDoors = [
  {
    title: 'Higher Education',
    description:
      'Capability programmes, student work-ready programmes, and leadership advisory for universities and colleges.',
    href: '/higher-education/',
    icon: 'tabler:building-bank',
    sector: 'he',
    cta: 'Explore HE',
  },
  {
    title: 'Schools and trusts',
    description: 'Practical AI training for teachers and administrative staff that buys back hours every week, safely.',
    href: '/schools/',
    icon: 'tabler:school',
    sector: 'schools',
    cta: 'Explore Schools',
  },
];
---

<Layout metadata={metadata} sector="neutral">
  <!-- 1. Hero -->
  <section class="bg-[#015887] px-6 py-16 text-white sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-8 md:grid-cols-12">
        <div class="text-center md:col-span-6 md:text-left">
          <h1 class="font-heading text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            AI skills training, designed for education.
          </h1>
          <p class="mx-auto mt-6 max-w-2xl font-sans text-lg leading-[1.7] text-[#86BFE2] md:mx-0 md:text-xl">
            Support your academics, teachers, staff and students to become AI confident, capable and safe.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row md:justify-start">
            <a
              href="/higher-education/"
              class="inline-flex items-center justify-center rounded-full bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#e55f00]"
              data-track="sector_door_click"
              data-track-sector="he"
            >
              For Higher Education
            </a>
            <a
              href="/schools/"
              class="inline-flex items-center justify-center rounded-full border-2 border-white/70 px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-white"
              data-track="sector_door_click"
              data-track-sector="schools"
            >
              For Schools
            </a>
          </div>
        </div>

        <div class="md:col-span-6">
          <div class="overflow-hidden rounded-2xl shadow-lg ring-1 ring-white/20">
            <video
              controls
              playsinline
              preload="metadata"
              class="aspect-video w-full bg-black"
              title="WorkSmart AI introduction video"
            >
              <source src="/videos/worksmart_intro.webm" type="video/webm" />
              <source src="/videos/worksmart_intro.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Credibility strip -->
  <section class="border-b border-gray-100 bg-white px-6 py-8 sm:px-8 lg:px-12" no-intersect aria-label="Credibility">
    <div class="mx-auto max-w-6xl text-center">
      <p class="font-heading text-xs font-bold uppercase tracking-wider text-gray-500">
        Built by people who have worked inside education
      </p>
      <ul class="mt-4 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-x-8">
        {
          credibilityMarkers.map((marker) => (
            <li class="flex items-center gap-2 font-sans text-sm font-semibold text-[#015887]">
              <Icon name="tabler:check" class="h-4 w-4 shrink-0" aria-hidden="true" />
              {marker}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Choose your sector -->
  <section class="bg-[#F8F8F8] px-6 py-16 sm:px-8 lg:px-12" no-intersect aria-labelledby="sector-doors-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="sector-doors-heading" class="text-center font-heading text-3xl font-bold text-[#015887] md:text-4xl">
        Choose your sector
      </h2>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {
          sectorDoors.map((door) => (
            <a
              href={door.href}
              class="group block rounded-2xl border border-gray-200 bg-white p-8 transition hover:shadow-lg"
              data-track="sector_door_click"
              data-track-sector={door.sector}
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#86BFE2]/20 text-[#015887]">
                <Icon name={door.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="mt-5 font-heading text-2xl font-bold text-[#015887]">{door.title}</h3>
              <p class="mt-3 font-sans leading-[1.65] text-gray-700">{door.description}</p>
              <span class="mt-5 inline-flex items-center font-heading text-sm font-semibold text-[#FF7700] group-hover:underline">
                {door.cta}{' '}
                <span class="ml-1 transition-transform group-hover:translate-x-1" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Shared proposition -->
  <section class="bg-[#F8F8F8] px-6 py-14 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-sans text-xl leading-relaxed text-[#1B0101] md:text-2xl">
        At WorkSmart-AI we specialise in improving AI capability and literacy for those in education, using practical,
        role-specific examples to help understanding and encourage immediate, safe implementation.
      </p>
    </div>
  </section>

  <!-- 5. Framework columns -->
  <section class="bg-white px-6 py-16 sm:px-8 lg:px-12" no-intersect aria-labelledby="approach-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="approach-heading" class="text-center font-heading text-3xl font-bold text-[#015887] md:text-4xl">
        A structured approach, not a one-off workshop
      </h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          frameworks.map((item) => (
            <div class="text-center md:text-left">
              <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-[#86BFE2]/20 text-[#015887] md:mx-0">
                <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="font-heading text-xl font-bold text-[#015887]">{item.title}</h3>
              <p class="mt-2 font-sans leading-[1.65] text-gray-700">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Proof / outcome band -->
  <section class="bg-[#F8F8F8] px-6 py-12 sm:px-8 lg:px-12" no-intersect aria-label="Client testimonial">
    <div class="mx-auto max-w-5xl">
      <div class="rounded-xl bg-[#015887] px-8 py-10 text-center md:text-left">
        <blockquote class="text-white">
          <p class="font-sans text-lg leading-[1.7] md:text-xl">
            &ldquo;Katie and Dave are specialists in working with educational leaders to design AI training courses to
            have maximum impact on their staff. Friendly to work with and efficient in their approach.&rdquo;
          </p>
          <footer class="mt-3 font-sans text-sm italic text-white/80">
            &mdash; Lisa Harris, Director of Digital Learning
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- 7. Closing CTA band -->
  <section class="bg-white px-6 py-16 sm:px-8 lg:px-12" no-intersect aria-labelledby="closing-cta-heading">
    <div class="mx-auto max-w-4xl text-center">
      <h2 id="closing-cta-heading" class="font-heading text-3xl font-bold text-[#015887] md:text-4xl">
        Not sure where your staff are starting from?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl font-sans text-lg leading-[1.7] text-gray-700">
        That is exactly what we help you find out. Whether you are a university or a school, the first step is a short
        conversation.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/health-check/"
          class="inline-flex items-center justify-center rounded-full bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#e55f00]"
        >
          Higher Education: book an AI Capability Check
        </a>
        <a
          href="/contact-us/"
          class="inline-flex items-center justify-center rounded-full border-2 border-[#015887] px-7 py-3 font-heading text-sm font-bold text-[#015887] transition hover:-translate-y-0.5 hover:bg-[#015887] hover:text-white"
        >
          Schools: book a 20-minute call
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initTrackClicks } from '~/lib/analytics/track-clicks';

  initTrackClicks();
</script>
