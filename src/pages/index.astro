---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import UpsellLadder from '~/components/brand/UpsellLadder.astro';
import CtaBand from '~/components/brand/CtaBand.astro';
import CornerDevice from '~/components/brand/CornerDevice.astro';
import { ONE_LINERS, TAGLINE, WHY_US } from '~/data/brand/copy';
import { CTAS } from '~/data/brand/ctas';
import { TESTIMONIALS } from '~/data/brand/testimonials';

const metadata = {
  title: 'AI skills training for universities, colleges, schools and organisations | WorkSmart-AI',
  description: ONE_LINERS.generic,
  canonical: '/',
};

const credibilityMarkers = [
  'Founded by former Digital Skills Leads at the University of Exeter',
  'Members of the Staff Development Forum',
];

const sectorDoors = [
  {
    title: 'Universities',
    description: 'Staff and student training, white-labelled courses, adoption coaching and academic coaching.',
    href: '/higher-education/',
    icon: 'tabler:building-bank',
    sector: 'he',
    cta: 'Explore Universities',
  },
  {
    title: 'Colleges',
    description:
      'Practical skills for teaching and support staff, self-paced online courses for students, and responsible use your learners can stand behind.',
    href: '/colleges/',
    icon: 'tabler:building-community',
    sector: 'fe',
    cta: 'Explore Colleges',
  },
  {
    title: 'Schools and trusts',
    description: 'INSET and staff training that tackles workload safely, built around your policy and safeguarding.',
    href: '/schools/',
    icon: 'tabler:school',
    sector: 'schools',
    cta: 'Explore Schools',
  },
  {
    title: 'Businesses and public sector',
    description:
      'Helping businesses understand where they can benefit from using AI. Skills for companies, councils, public bodies and charities.',
    href: '/business/',
    icon: 'tabler:briefcase',
    sector: 'business',
    cta: 'Explore Businesses',
  },
];
---

<Layout metadata={metadata} sector="neutral">
  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-[#015887] px-6 py-16 text-white sm:px-8 md:py-20 lg:px-12" no-intersect>
    <CornerDevice tone="dark" class="hidden w-28 md:block lg:w-36" />
    <div class="relative z-10 mx-auto max-w-7xl">
      <div class="grid items-center gap-8 md:grid-cols-12">
        <div class="text-center md:col-span-6 md:text-left">
          <h1 class="font-heading text-[32px] font-bold leading-tight tracking-tight sm:text-5xl">{TAGLINE}</h1>
          <p class="mx-auto mt-6 max-w-2xl font-sans text-lg leading-[1.7] text-[#86BFE2] md:mx-0 md:text-xl">
            {ONE_LINERS.generic}
          </p>
          <div class="mt-8 flex flex-col items-center gap-4 md:items-start">
            <a
              href={CTAS.primary.href}
              class="inline-flex items-center justify-center rounded-full bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#e55f00]"
            >
              {CTAS.primary.text}
            </a>
            <a
              href={CTAS.calculator.href}
              class="hidden font-sans text-sm text-white/90 underline md:inline underline-offset-4 transition hover:text-white"
            >
              {CTAS.calculator.text}
            </a>
          </div>
        </div>

        <div class="hidden md:col-span-6 md:block">
          <div class="overflow-hidden rounded-2xl shadow-lg ring-1 ring-white/20">
            <iframe
              loading="lazy"
              title="WorkSmart-AI introduction video"
              src="https://www.youtube.com/embed/RuQWTW0lGHE"
              class="aspect-video w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Trust strip -->
  <section
    class="border-b border-gray-100 bg-white px-6 py-10 sm:px-8 lg:px-12"
    no-intersect
    aria-label="What clients say"
  >
    <figure class="mx-auto max-w-3xl text-center">
      <blockquote>
        <p class="font-heading text-lg font-semibold leading-[1.6] text-[#015887] sm:text-xl">
          &ldquo;{TESTIMONIALS.lynch.quote}&rdquo;
        </p>
      </blockquote>
      <figcaption class="mt-3 font-sans text-sm text-gray-700">
        {TESTIMONIALS.lynch.name}, {TESTIMONIALS.lynch.role}
      </figcaption>
    </figure>
    <p class="mx-auto mt-5 max-w-3xl text-center font-sans text-sm text-gray-600">
      {credibilityMarkers.join(' · ')}
    </p>
  </section>

  <!-- 2b. Video on phones, below the fold -->
  <section class="bg-white px-6 pb-10 md:hidden" no-intersect aria-label="Introduction video">
    <div class="overflow-hidden rounded-2xl shadow-lg">
      <iframe
        loading="lazy"
        title="WorkSmart-AI introduction video"
        src="https://www.youtube.com/embed/RuQWTW0lGHE"
        class="aspect-video w-full"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </section>

  <!-- 3. Choose your sector -->
  <section class="bg-[#F8F8F8] px-6 py-16 sm:px-8 lg:px-12" no-intersect aria-labelledby="sector-doors-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="sector-doors-heading" class="text-center font-heading text-3xl font-bold text-[#015887] md:text-4xl">
        Who we work with
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          sectorDoors.map((door) => (
            <a
              href={door.href}
              class="group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 pb-10 transition hover:border-[#015887]"
              data-track="sector_door_click"
              data-track-sector={door.sector}
            >
              <CornerDevice class="w-16 origin-bottom-right transition-transform duration-300 group-hover:scale-110" />
              <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#86BFE2]/20 text-[#015887]">
                <Icon name={door.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="mt-5 font-heading text-2xl font-bold text-[#015887]">{door.title}</h3>
              <p class="mt-3 font-sans leading-[1.65] text-gray-700">{door.description}</p>
              <span class="mt-auto inline-flex items-center pt-5 font-heading text-sm font-semibold text-[#FF7700] group-hover:underline">
                {door.cta}{' '}
                <span class="ml-1 transition-transform group-hover:translate-x-1" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Testimonial -->
  <section class="bg-[#015887] px-6 py-8 sm:px-8 md:py-10 lg:px-12" no-intersect aria-label="Testimonial">
    <div class="mx-auto max-w-3xl border-l-4 border-[#FF7700] pl-5 sm:pl-7">
      <blockquote>
        <p class="font-sans text-base font-bold leading-[1.7] text-white sm:text-lg">
          &ldquo;Katie and Dave are specialists in working with educational leaders to design AI training courses to
          have maximum impact on their staff. Friendly to work with and efficient in their approach.&rdquo;
        </p>
      </blockquote>
      <p class="mt-4 font-sans text-sm italic leading-[1.6] text-white/80">
        Lisa Harris, Director of Digital Learning, University of Exeter
      </p>
    </div>
  </section>

  <!-- 5. Start small -->
  <section class="bg-white px-6 py-16 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        title="Start small, build from there"
        subtitle="Begin with the free check, then add what your people need next."
      />
      <UpsellLadder />
      <p class="mt-8 text-center">
        <a
          href="/services/"
          class="inline-flex items-center font-heading text-sm font-semibold text-[#015887] underline underline-offset-4 hover:text-[#FF7700]"
        >
          See all services <span class="ml-1" aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- 8. Why us -->
  <section class="bg-white px-6 py-16 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader title="Education specialists, not tool demos" />
      <div class="grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          WHY_US.map((item) => (
            <div>
              <h3 class="flex items-start gap-3 font-heading text-xl font-bold text-[#015887]">
                <Icon name={item.icon} class="mt-0.5 h-6 w-6 shrink-0 text-[#FF7700]" aria-hidden="true" />
                {item.title}
              </h3>
              <p class="mt-2 pl-9 font-sans leading-[1.65] text-gray-700">{item.proof}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure where your staff are starting from?"
    subtitle="That's what the free AI Capability Check finds out: a 30-minute call and a written report with two or three next steps, for any university, college, school or organisation."
  />
</Layout>

<script>
  import { initTrackClicks } from '~/lib/analytics/track-clicks';

  initTrackClicks();
</script>
