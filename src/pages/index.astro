---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import SectionHeader from '~/components/brand/SectionHeader.astro';
import HierarchyLadder from '~/components/brand/HierarchyLadder.astro';
import EvidenceStats from '~/components/brand/EvidenceStats.astro';
import ServiceCards from '~/components/brand/ServiceCards.astro';
import CtaBand from '~/components/brand/CtaBand.astro';
import { HEADLINE_OUTCOMES, ONE_LINERS, PILLARS, TAGLINE, WHY_US } from '~/data/brand/copy';
import { CTAS } from '~/data/brand/ctas';
import { EVIDENCE } from '~/data/brand/evidence';

const metadata = {
  title: 'AI skills training for universities, colleges, schools and organisations | WorkSmart-AI',
  description: ONE_LINERS.generic,
  canonical: '/',
};

const credibilityMarkers = [
  'Founded by former Digital Skills Leads at the University of Exeter',
  'Worked with the University of Southampton',
  '290 use cases across 14 staff roles',
];

const sectorDoors = [
  {
    title: 'Universities',
    description: 'Staff and student training, white-labelled courses, adoption coaching and academic coaching.',
    href: '/higher-education/',
    icon: 'tabler:building-bank',
    sector: 'he',
    cta: 'Explore Universities',
  },
  {
    title: 'Colleges',
    description: 'Practical skills for teaching and support staff, and responsible use your learners can stand behind.',
    href: '/colleges/',
    icon: 'tabler:building-community',
    sector: 'fe',
    cta: 'Explore Colleges',
  },
  {
    title: 'Schools and trusts',
    description: 'INSET and staff training that tackles workload safely, built around your policy and safeguarding.',
    href: '/schools/',
    icon: 'tabler:school',
    sector: 'schools',
    cta: 'Explore Schools',
  },
  {
    title: 'Businesses and public sector',
    description: 'AI skills for companies, councils, public bodies and charities, and more from your Copilot licences.',
    href: '/business/',
    icon: 'tabler:briefcase',
    sector: 'business',
    cta: 'Explore Businesses',
  },
];

const evidence = [EVIDENCE.employerTraining, EVIDENCE.unapprovedTools, EVIDENCE.staffDevelopment];
---

<Layout metadata={metadata} sector="neutral">
  <!-- 1. Hero -->
  <section class="bg-[#015887] px-6 py-16 text-white sm:px-8 md:py-20 lg:px-12" no-intersect>
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-8 md:grid-cols-12">
        <div class="text-center md:col-span-6 md:text-left">
          <h1 class="font-heading text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{TAGLINE}</h1>
          <p class="mx-auto mt-6 max-w-2xl font-sans text-lg leading-[1.7] text-[#86BFE2] md:mx-0 md:text-xl">
            {ONE_LINERS.generic}
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row md:justify-start">
            <a
              href={CTAS.primary.href}
              class="inline-flex items-center justify-center rounded-full bg-[#FF7700] px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#e55f00]"
            >
              {CTAS.primary.text}
            </a>
            <a
              href={CTAS.calculator.href}
              class="inline-flex items-center justify-center rounded-full border-2 border-white/70 px-7 py-3 font-heading text-sm font-bold text-white transition hover:-translate-y-0.5 hover:border-white"
            >
              {CTAS.calculator.text}
            </a>
          </div>
        </div>

        <div class="md:col-span-6">
          <div class="overflow-hidden rounded-2xl shadow-lg ring-1 ring-white/20">
            <iframe
              title="WorkSmart-AI introduction video"
              src="https://www.youtube.com/embed/RuQWTW0lGHE"
              class="aspect-video w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Credibility strip -->
  <section class="border-b border-gray-100 bg-white px-6 py-8 sm:px-8 lg:px-12" no-intersect aria-label="Credibility">
    <ul
      class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-3 text-center sm:flex-row sm:flex-wrap sm:gap-x-8"
    >
      {
        credibilityMarkers.map((marker) => (
          <li class="flex items-center gap-2 font-sans text-sm font-semibold text-[#015887]">
            <Icon name="tabler:check" class="h-4 w-4 shrink-0" aria-hidden="true" />
            {marker}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3. Choose your sector -->
  <section class="bg-[#F8F8F8] px-6 py-16 sm:px-8 lg:px-12" no-intersect aria-labelledby="sector-doors-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="sector-doors-heading" class="text-center font-heading text-3xl font-bold text-[#015887] md:text-4xl">
        Who we work with
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          sectorDoors.map((door) => (
            <a
              href={door.href}
              class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-6 transition hover:shadow-lg"
              data-track="sector_door_click"
              data-track-sector={door.sector}
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#86BFE2]/20 text-[#015887]">
                <Icon name={door.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="mt-5 font-heading text-2xl font-bold text-[#015887]">{door.title}</h3>
              <p class="mt-3 font-sans leading-[1.65] text-gray-700">{door.description}</p>
              <span class="mt-auto inline-flex items-center pt-5 font-heading text-sm font-semibold text-[#FF7700] group-hover:underline">
                {door.cta}{' '}
                <span class="ml-1 transition-transform group-hover:translate-x-1" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Problem and outcomes -->
  <section class="bg-white px-6 py-16 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Why it matters"
        title="Most staff now use AI. Few have been trained to use it well."
        subtitle="AI tools only make organisations more productive when people can use them well. We teach practical AI skills on real tasks, built around your policy and tools, and track progress against published outcomes."
      />
      <EvidenceStats items={evidence} />
      <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          HEADLINE_OUTCOMES.map((o) => (
            <li class="flex items-center gap-3 rounded-xl bg-[#F8F8F8] p-5 font-heading font-bold text-[#015887]">
              <Icon name={o.icon} class="h-7 w-7 shrink-0 text-[#FF7700]" aria-hidden="true" />
              {o.title}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Three pillars -->
  <section class="bg-[#F8F8F8] px-6 py-16 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="How we get there"
        title="Capability, confidence and compliance"
        subtitle="Productivity is the outcome. These three are how we get there, and each is measured."
      />
      <div class="grid gap-6 md:grid-cols-3">
        {
          PILLARS.map((p) => (
            <div class="rounded-xl bg-white p-6 shadow-card">
              <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#86BFE2]/20 text-[#015887]">
                <Icon name={p.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="mt-4 font-heading text-xl font-bold text-[#015887]">{p.name}</h3>
              <p class="mt-2 font-sans leading-[1.65] text-gray-700">{p.meaning}</p>
              <p class="mt-4 text-sm text-gray-500">Measured by: {p.measuredBy.toLowerCase()}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Why us -->
  <section class="bg-white px-6 py-16 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader eyebrow="Why WorkSmart-AI" title="Education specialists, not tool demos" />
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          WHY_US.map((item) => (
            <div>
              <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-[#86BFE2]/20 text-[#015887]">
                <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="font-heading text-xl font-bold text-[#015887]">{item.title}</h3>
              <p class="mt-2 font-sans leading-[1.65] text-gray-700">{item.proof}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7. AI Use Hierarchy -->
  <section class="bg-[#F8F8F8] px-6 py-16 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="A structured path"
        title="The AI Use Hierarchy"
        subtitle="Five levels, from first use to institutional capability. Every course, workshop and AI Capability Check is mapped against it, so staff and leaders see where they are and what comes next."
      />
      <HierarchyLadder />
    </div>
  </section>

  <!-- 8. Services -->
  <section class="bg-white px-6 py-16 sm:px-8 lg:px-12" no-intersect>
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="What we offer"
        title="Training, coaching and consultancy"
        subtitle="We publish topics and formats, then build each engagement around you."
      />
      <ServiceCards />
    </div>
  </section>

  <!-- 9. Testimonial -->
  <section class="bg-[#F8F8F8] px-6 py-12 sm:px-8 lg:px-12" no-intersect aria-label="Testimonial">
    <div class="mx-auto max-w-5xl">
      <div class="rounded-xl bg-[#015887] px-8 py-10 text-center md:text-left">
        <blockquote class="text-white">
          <p class="font-sans text-lg leading-[1.7] md:text-xl">
            &ldquo;Katie and Dave are specialists in working with educational leaders to design AI training courses to
            have maximum impact on their staff. Friendly to work with and efficient in their approach.&rdquo;
          </p>
          <footer class="mt-3 font-sans text-sm italic text-white/80">
            Lisa Harris, Director of Digital Learning, University of Exeter
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure where your staff are starting from?"
    subtitle="That's what the free AI Capability Check finds out: a 30-minute call and a written report with two or three next steps, for any university, college, school or organisation."
  />
</Layout>

<script>
  import { initTrackClicks } from '~/lib/analytics/track-clicks';

  initTrackClicks();
</script>
