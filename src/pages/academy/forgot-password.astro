---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Reset Your Password | WorkSmart-AI',
  description: 'Request a link to reset your WorkSmart-AI Academy password.',
  canonical: '/academy/forgot-password/',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden bg-brand px-6 py-20 sm:px-8 lg:px-12">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand via-brand to-[#013a5c] opacity-95">
    </div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.08]"
      style="background-image:radial-gradient(rgba(255,255,255,0.9) 1px, transparent 1px);background-size:20px 20px;"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl">
      <div class="mx-auto max-w-md rounded-2xl border border-white/20 bg-white p-8 shadow-2xl ring-1 ring-slate-900/5">
        <p class="font-heading text-xs font-bold uppercase tracking-[0.2em] text-accent">Academy access</p>
        <h1 class="mt-3 font-heading text-3xl font-bold text-heading">Forgot your password?</h1>
        <p class="mt-2 text-sm text-muted">
          Enter the email you sign in with and we'll send you a link to set a new password.
        </p>

        <form id="forgot-password-form" class="mt-8 space-y-4">
          <div>
            <label for="forgot-email" class="block text-sm font-semibold text-heading">Email</label>
            <input
              id="forgot-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="mt-1.5 block w-full rounded-xl border border-default bg-card px-4 py-3 text-default shadow-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              placeholder="you@organisation.com"
            />
          </div>

          <p id="forgot-password-feedback" class="hidden rounded-lg px-3 py-2 text-sm" role="alert"></p>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-full border-2 border-brand bg-brand px-5 py-3 font-heading font-semibold text-white transition hover:bg-accent hover:border-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
          >
            Send reset link
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-muted">
          <a class="text-primary underline hover:no-underline" href="/academy/login/">Back to sign in</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { academySupabase, hasAcademySupabaseConfig } from '~/lib/academy';

  const form = document.getElementById('forgot-password-form');
  const feedback = document.getElementById('forgot-password-feedback') as HTMLParagraphElement | null;

  if (!(form instanceof HTMLFormElement)) {
    throw new Error('Forgot password form not found');
  }

  const setFeedback = (message: string, isError: boolean = true) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = isError
      ? 'rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800'
      : 'rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800';
  };

  const emailInput = form.querySelector('input[name="email"]');
  const prefill = new URLSearchParams(window.location.search).get('email');
  if (prefill && emailInput instanceof HTMLInputElement) emailInput.value = prefill;

  if (!hasAcademySupabaseConfig || !academySupabase) {
    setFeedback('Password reset is unavailable right now. Please contact support.');
  } else {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector('button[type="submit"]');
      const email = String(new FormData(form).get('email') || '').trim();

      if (!email) {
        setFeedback('Please enter your email address.');
        return;
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (feedback) feedback.className = 'hidden';

      try {
        const supabase = academySupabase;
        if (!supabase) {
          setFeedback('Password reset is unavailable right now. Please contact support.');
          return;
        }
        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: `${window.location.origin}/academy/reset-password/`,
        });

        if (error) {
          setFeedback(error.message || 'We could not send a reset link. Please try again.');
          return;
        }

        // Same message whether or not the account exists, so the form can't be used to probe for emails.
        setFeedback(
          `If ${email} has an Academy account, a reset link is on its way. Open it in this browser to set a new password.`,
          false
        );
        form.reset();
      } catch (caughtError) {
        const message = caughtError instanceof Error ? caughtError.message : 'Unexpected error.';
        setFeedback(`We could not send a reset link: ${message}`);
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
      }
    });
  }
</script>
