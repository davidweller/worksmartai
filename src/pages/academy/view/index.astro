---
import Layout from '~/layouts/PageLayout.astro';
import CoursePlayer from '~/components/academy/CoursePlayer.astro';

// Player for any course in public.courses, by ?id=.
const metadata = {
  title: 'Academy Course Player | WorkSmart-AI',
  description: 'Launch your WorkSmart-AI Academy course and continue from your saved progress.',
  canonical: '/academy/view/',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <CoursePlayer />
</Layout>
