---
import Layout from '~/layouts/PageLayout.astro';
import CoursePlayer from '~/components/academy/CoursePlayer.astro';

// Pretty URLs for courses that existed at build time. Courses added from /academy/admin/
// use /academy/view/?id={id} (view/index.astro) and need no rebuild.
export function getStaticPaths() {
  return ['ai-foundations', 'copilot-intermediate-advanced'].map((courseId) => ({
    params: { courseId },
  }));
}

const courseId = Astro.params.courseId ?? '';

const metadata = {
  title: 'Academy Course Player | WorkSmart-AI',
  description: 'Launch your WorkSmart-AI Academy course and continue from your saved progress.',
  canonical: `/academy/view/${courseId}/`,
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <CoursePlayer courseId={courseId} />
</Layout>
