---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Set a New Password | WorkSmart-AI',
  description: 'Set a new password for your WorkSmart-AI Academy account.',
  canonical: '/academy/reset-password/',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden bg-brand px-6 py-20 sm:px-8 lg:px-12">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand via-brand to-[#013a5c] opacity-95">
    </div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.08]"
      style="background-image:radial-gradient(rgba(255,255,255,0.9) 1px, transparent 1px);background-size:20px 20px;"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl">
      <div class="mx-auto max-w-md rounded-2xl border border-white/20 bg-white p-8 shadow-2xl ring-1 ring-slate-900/5">
        <p class="font-heading text-xs font-bold uppercase tracking-[0.2em] text-accent">Academy access</p>
        <h1 class="mt-3 font-heading text-3xl font-bold text-heading">Set a new password</h1>
        <p class="mt-2 text-sm text-muted">Choose a password of at least 8 characters.</p>

        <form id="reset-password-form" class="mt-8 space-y-4" hidden>
          <div>
            <label for="reset-password" class="block text-sm font-semibold text-heading">New password</label>
            <input
              id="reset-password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              class="mt-1.5 block w-full rounded-xl border border-default bg-card px-4 py-3 text-default shadow-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            />
          </div>

          <div>
            <label for="reset-password-confirm" class="block text-sm font-semibold text-heading"
              >Confirm new password</label
            >
            <input
              id="reset-password-confirm"
              name="confirm"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              class="mt-1.5 block w-full rounded-xl border border-default bg-card px-4 py-3 text-default shadow-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            />
          </div>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-full border-2 border-brand bg-brand px-5 py-3 font-heading font-semibold text-white transition hover:bg-accent hover:border-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
          >
            Save password
          </button>
        </form>

        <p id="reset-password-feedback" class="mt-4 rounded-lg px-3 py-2 text-sm text-muted" role="alert">
          Checking your reset link...
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { academySupabase, forgotPasswordHref, hasAcademySupabaseConfig } from '~/lib/academy';

  const form = document.getElementById('reset-password-form');
  const feedback = document.getElementById('reset-password-feedback') as HTMLParagraphElement | null;

  if (!(form instanceof HTMLFormElement)) {
    throw new Error('Reset password form not found');
  }

  const setFeedback = (message: string, isError: boolean = true) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = isError
      ? 'mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800'
      : 'mt-4 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800';
  };

  const showExpired = () => {
    if (!feedback) return;
    const link = document.createElement('a');
    link.href = forgotPasswordHref();
    link.textContent = 'Request a new one';
    link.className = 'font-semibold underline hover:no-underline';
    setFeedback('');
    feedback.replaceChildren('This reset link has expired or was opened in a different browser. ', link, '.');
  };

  if (!hasAcademySupabaseConfig || !academySupabase) {
    setFeedback('Password reset is unavailable right now. Please contact support.');
  } else {
    const supabase = academySupabase;
    const params = new URLSearchParams(window.location.search);
    const hashParams = new URLSearchParams(window.location.hash.slice(1));

    // Admin invites arrive as ?token_hash=&type=invite and are verified here.
    // Reset emails carry ?code=, which the client exchanges for a session on load.
    const tokenHash = params.get('token_hash');
    if (tokenHash && params.get('type') === 'invite') {
      const heading = document.querySelector('h1');
      if (heading) heading.textContent = 'Set your password';
      await supabase.auth.verifyOtp({ token_hash: tokenHash, type: 'invite' });
    }

    const { data, error } = await supabase.auth.getSession();

    if (error || !data.session || params.has('error') || hashParams.has('error')) {
      showExpired();
    } else {
      form.hidden = false;
      if (feedback) feedback.className = 'hidden';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submitButton = form.querySelector('button[type="submit"]');
        const formData = new FormData(form);
        const password = String(formData.get('password') || '');
        const confirm = String(formData.get('confirm') || '');

        if (password.length < 8) {
          setFeedback('Your password needs at least 8 characters.');
          return;
        }
        if (password !== confirm) {
          setFeedback("The two passwords don't match.");
          return;
        }

        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

        try {
          const { error: updateError } = await supabase.auth.updateUser({ password });
          if (updateError) {
            setFeedback(updateError.message || 'We could not save your password. Please try again.');
            return;
          }

          setFeedback('Password saved. Taking you to your dashboard...', false);
          window.location.replace('/academy/dashboard/');
        } catch (caughtError) {
          const message = caughtError instanceof Error ? caughtError.message : 'Unexpected error.';
          setFeedback(`We could not save your password: ${message}`);
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    }
  }
</script>
