---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Academy Dashboard | WorkSmart-AI',
  description: 'Track your course progress in the WorkSmart-AI Academy.',
  canonical: '/academy/dashboard/',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="bg-page px-6 py-16 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-heading text-xs font-bold uppercase tracking-[0.2em] text-accent">Academy</p>
          <h1 class="mt-2 font-heading text-3xl font-bold text-heading sm:text-4xl">Your course dashboard</h1>
          <p class="mt-2 text-sm text-muted">Resume where you left off and track progress across your learning path.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            id="academy-admin-link"
            href="/academy/admin/"
            class="hidden items-center justify-center rounded-full border border-default bg-card px-5 py-2.5 text-sm font-semibold text-default transition hover:border-brand hover:text-brand"
          >
            Admin
          </a>
          <button
            id="academy-signout-button"
            class="inline-flex items-center justify-center rounded-full border border-default bg-card px-5 py-2.5 text-sm font-semibold text-default transition hover:border-brand hover:text-brand"
          >
            Sign out
          </button>
        </div>
      </div>

      <p id="academy-dashboard-feedback" class="mt-6 hidden rounded-lg px-3 py-2 text-sm" role="alert"></p>

      <section class="mt-8 rounded-2xl border border-default bg-card p-6 shadow-card sm:p-8">
        <p
          id="academy-course-intro-label"
          class="font-heading text-xs font-bold uppercase tracking-[0.2em] text-accent"
        >
          Staff training
        </p>
        <h2 id="academy-course-heading" class="mt-2 font-heading text-2xl font-bold text-heading sm:text-3xl">
          Your enrolled courses
        </h2>
        <p id="academy-course-intro" class="mt-2 max-w-3xl text-sm leading-relaxed text-muted">
          Resume where you left off and track progress across your enrolled workshops.
        </p>

        <p
          id="academy-empty-enrollments"
          class="mt-8 hidden rounded-xl border border-default bg-page px-5 py-6 text-sm leading-relaxed text-muted"
          role="status"
        >
          You are not enrolled in any courses yet. Please contact your administrator.
        </p>

        <div id="academy-course-grid" class="mt-8 hidden space-y-8" aria-busy="true"></div>
      </section>
    </div>
  </section>
</Layout>

<script>
  import { academySupabase, hasAcademySupabaseConfig, requireAuth } from '~/lib/academy';
  import { COURSE_GROUPS, coursePlayerHref, escapeHtml, fetchCourses, type AcademyCourse } from '~/lib/academy/courses';
  import { openCertificateDialog, type Certificate } from '~/lib/academy/certificates';

  const feedback = document.getElementById('academy-dashboard-feedback') as HTMLParagraphElement | null;
  const signOutButton = document.getElementById('academy-signout-button') as HTMLButtonElement | null;

  const setFeedback = (message: string, isError: boolean = true) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = isError
      ? 'mt-6 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800'
      : 'mt-6 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800';
  };

  const renderLiveCourseProgress = (progressByCourseId: Record<string, number> = {}) => {
    const progressBars = document.querySelectorAll('[data-progress-bar]');

    progressBars.forEach((bar) => {
      if (!(bar instanceof HTMLElement)) return;
      const courseId = bar.getAttribute('data-progress-bar');
      if (!courseId || bar.closest('.hidden')) return;

      const progress = Number(progressByCourseId[courseId] ?? 0);
      const clampedProgress = Number.isFinite(progress) ? Math.max(0, Math.min(100, Math.round(progress))) : 0;
      const progressLabels = document.querySelectorAll(`[data-progress-label="${courseId}"]`);

      progressLabels.forEach((label) => {
        label.textContent = `${clampedProgress}%`;
      });
      bar.style.width = `${clampedProgress}%`;
    });
  };

  const renderCertificates = (certificates: Certificate[]) => {
    for (const certificate of certificates) {
      const courseId = certificate.course_id;
      document.querySelectorAll(`[data-progress-label="${courseId}"]`).forEach((label) => {
        label.textContent = 'Completed';
      });
      const bar = document.querySelector<HTMLElement>(`[data-progress-bar="${courseId}"]`);
      if (bar) bar.style.width = '100%';
      const button = document.querySelector<HTMLButtonElement>(`[data-certificate-button="${courseId}"]`);
      if (button) {
        button.classList.remove('hidden');
        button.classList.add('inline-flex');
        button.addEventListener('click', () => openCertificateDialog(certificate));
      }
    }
  };

  const renderCourseCard = (course: AcademyCourse) => `
    <article class="rounded-xl border border-default bg-page p-5" data-course-id="${escapeHtml(course.id)}">
      <h4 class="text-base font-semibold text-heading">${escapeHtml(course.title)}</h4>
      <p class="mt-2 text-sm leading-relaxed text-muted">${escapeHtml(course.summary)}</p>
      <p class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
        ${escapeHtml(course.level)}
      </p>
      ${
        course.is_live
          ? `<div class="mt-5">
              <div class="mb-1.5 flex items-center justify-between text-xs font-semibold uppercase tracking-wide text-muted">
                <span>Progress</span>
                <span data-progress-label="${escapeHtml(course.id)}">0%</span>
              </div>
              <div class="h-2 rounded-full bg-slate-200">
                <div class="h-full rounded-full bg-accent transition-all" style="width: 0%" data-progress-bar="${escapeHtml(course.id)}"></div>
              </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-3">
              <a
                href="${coursePlayerHref(course.id)}"
                class="inline-flex items-center justify-center rounded-full border-2 border-brand bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:border-accent hover:bg-accent"
              >
                Continue course
              </a>
              <button
                type="button"
                data-certificate-button="${escapeHtml(course.id)}"
                class="hidden items-center justify-center rounded-full border-2 border-accent bg-card px-4 py-2 text-sm font-semibold text-accent transition hover:bg-accent hover:text-white"
              >
                View certificate
              </button>
            </div>`
          : `<p class="mt-5 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-700">
              Coming soon
            </p>`
      }
    </article>`;

  // Shows only the courses this learner is enrolled in, grouped by audience.
  const renderEnrolledCourses = (courses: AcademyCourse[], enrolledCourseIds: Set<string>) => {
    const courseGrid = document.getElementById('academy-course-grid');
    const emptyState = document.getElementById('academy-empty-enrollments');
    const introLabel = document.getElementById('academy-course-intro-label');
    const intro = document.getElementById('academy-course-intro');

    const enrolled = courses.filter((course) => enrolledCourseIds.has(course.id));
    const groupNames = [
      ...COURSE_GROUPS,
      ...new Set(enrolled.map((course) => course.group_name).filter((name) => !COURSE_GROUPS.includes(name))),
    ];

    if (courseGrid) {
      courseGrid.innerHTML = groupNames
        .map((groupName) => {
          const groupCourses = enrolled.filter((course) => course.group_name === groupName);
          if (groupCourses.length === 0) return '';
          return `
            <div data-course-group>
              <h3 class="font-heading text-xl font-bold text-heading">${escapeHtml(groupName)}</h3>
              <div class="mt-4 grid gap-4 md:grid-cols-2">${groupCourses.map(renderCourseCard).join('')}</div>
            </div>`;
        })
        .join('');
    }

    const hasCourses = enrolled.length > 0;
    emptyState?.classList.toggle('hidden', hasCourses);
    courseGrid?.classList.toggle('hidden', !hasCourses);
    introLabel?.classList.toggle('hidden', !hasCourses);
    intro?.classList.toggle('hidden', !hasCourses);
    courseGrid?.setAttribute('aria-busy', 'false');
  };

  if (!hasAcademySupabaseConfig || !academySupabase) {
    setFeedback('Dashboard is unavailable. Missing Supabase configuration.');
  } else {
    const authState = await requireAuth('/academy/login/');
    const user = authState?.user;

    if (user) {
      if (user.app_metadata?.role === 'admin') {
        const adminLink = document.getElementById('academy-admin-link');
        adminLink?.classList.remove('hidden');
        adminLink?.classList.add('inline-flex');
      }

      const { data: enrollmentRows, error: enrollmentError } = await academySupabase
        .from('enrollments')
        .select('course_id')
        .eq('user_id', user.id);

      let courses: AcademyCourse[] | null = null;
      try {
        courses = await fetchCourses();
      } catch {
        courses = null;
      }

      if (enrollmentError || !courses) {
        setFeedback('We could not load your courses yet. Please refresh and try again.');
      } else {
        const enrolledCourseIds = new Set((enrollmentRows || []).map((row) => String(row.course_id)).filter(Boolean));
        renderEnrolledCourses(courses, enrolledCourseIds);

        const { data: progressRows, error: progressError } = await academySupabase
          .from('progress_compat')
          .select('course_id, progress_percent')
          .eq('user_id', user.id);

        if (progressError) {
          setFeedback('We could not load your progress yet. Please refresh and try again.');
        } else {
          const progressByCourseId = Object.fromEntries(
            (progressRows || []).map((row) => [String(row.course_id), Number(row.progress_percent || 0)])
          );
          renderLiveCourseProgress(progressByCourseId);
        }

        // A certificate is the completion record: it wins over a later, partly done session.
        const { data: certificateRows } = await academySupabase
          .from('certificates')
          .select('id, cert_code, course_id, learner_name, course_title, issued_at')
          .eq('user_id', user.id);
        renderCertificates((certificateRows || []) as Certificate[]);
      }

      if (signOutButton) {
        signOutButton.addEventListener('click', async () => {
          const supabase = academySupabase;
          if (!supabase) {
            setFeedback('Sign out is unavailable right now. Please refresh and try again.');
            return;
          }
          await supabase.auth.signOut();
          window.location.replace('/academy/login/');
        });
      }
    }
  }
</script>
