    font-family: 'Work Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 17px;
    margin: 0;
    color: var(--navy);
    line-height: 1.25;
  }
  .entry .also {
    font-size: 13px;
    color: var(--ink-soft);
    font-weight: 400;
  }
  .tag {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    font-family: 'Work Sans', system-ui, sans-serif;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 3px 7px;
    white-space: nowrap;
  }
  .entry p {
    grid-column: 1 / -1;
    margin: 2px 0 0;
    font-size: 15px;
    line-height: 1.55;
  }
  .entry .not {
    grid-column: 1 / -1;
    margin: 8px 0 0;
    font-size: 13.5px;
    color: var(--ink-soft);
    border-left: 3px solid var(--sky);
    padding-left: 10px;
  }
  .entry .not b {
    color: var(--ink);
    font-weight: 700;
  }
  .entry .src {
    grid-column: 1 / -1;
    margin: 8px 0 0;
    font-size: 12.5px;
    color: var(--ink-soft);
  }
  .entry .src a {
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .entry .src a:hover {
    color: var(--orange);
  }
  .hidden {
    display: none !important;
  }

  .empty {
    display: none;
    margin-top: 40px;
    padding: 24px;
    text-align: center;
    border: 1px dashed var(--rule);
    border-radius: 3px;
    color: var(--ink-soft);
  }
  .empty.show {
    display: block;
  }

  .foot {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 2px solid var(--rule);
    font-size: 13.5px;
    color: var(--ink-soft);
    max-width: 74ch;
  }
  .foot strong {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .entry {
      grid-template-columns: 1fr;
    }
    .tag {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-top: 4px;
    }
  }
</style>

<script is:inline>
  (function () {
    const q = document.getElementById('q');
    const count = document.getElementById('count');
    const empty = document.getElementById('empty');
    if (!(q instanceof HTMLInputElement) || !count || !empty) return;

    const groups = Array.from(document.querySelectorAll('.lgroup'));
    const entries = Array.from(document.querySelectorAll('.entry'));
    const buttons = Array.from(document.querySelectorAll('.filters button'));
    let cat = 'all';

    entries.forEach((entry) => {
      const clone = entry.cloneNode(true);
      clone.querySelectorAll('.src').forEach((node) => node.remove());
      entry.dataset.text = (clone.textContent || '').toLowerCase().replace(/\s+/g, ' ');
    });

    function apply() {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      entries.forEach((entry) => {
        const ok =
          (cat === 'all' || entry.dataset.cat === cat) && (term === '' || (entry.dataset.text || '').includes(term));
        entry.classList.toggle('hidden', !ok);
        if (ok) shown += 1;
      });
      groups.forEach((group) => {
        const any = group.querySelector('.entry:not(.hidden)');
        group.classList.toggle('hidden', !any);
      });
      count.textContent = `${shown} of ${entries.length} terms`;
      empty.classList.toggle('show', shown === 0);
    }

    q.addEventListener('input', apply);
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        cat = button.dataset.cat || 'all';
        buttons.forEach((other) => {
          other.setAttribute('aria-pressed', String(other === button));
        });
        apply();
      });
    });

    apply();
  })();
</script>
