# Copy to .env for local `npm run build` / `astro dev`.
# In GitHub Actions, set the same as repository secrets (used by .github/workflows/hostinger-deploy.yaml)
# so the static site embeds the public anon key in the lead form.
#
# Hostinger API token for `npm run deploy:hostinger` (hPanel → Profile → API):
# HOSTINGER_API_TOKEN=
#
# Supabase: Project Settings -> API -> Project URL and anon (public) key.

PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
