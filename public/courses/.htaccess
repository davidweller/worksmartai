# Uploaded course files are static. Never execute scripts here, and hide the
# .tmp-* and .old-* folders the admin uploader creates.
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /courses/\.
Options -Indexes

# Course pages change when a course is replaced, but their URLs don't, so
# browsers must revalidate HTML (and the manifest/API shim) on every load.
# Media keeps a day of caching - replacements rarely reuse image names.
<FilesMatch "\.(html|xml|js)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.(png|jpe?g|gif|webp|svg|mp4|docx|xlsx|pdf)$">
  Header set Cache-Control "max-age=86400"
</FilesMatch>
